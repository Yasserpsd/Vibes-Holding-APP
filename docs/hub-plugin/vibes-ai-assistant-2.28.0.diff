+		} else {
+			$paid = (int) $c->paid_is_member === 1;
+			$row  = array(
+				'honorary'          => 0,
+				'honorary_at'       => null,
+				'is_member'         => $paid ? 1 : 0,
+				'stage'             => $paid ? 2 : max( 1, (int) $c->stage === 2 ? 1 : (int) $c->stage ),
+				'member_started_at' => $paid && ! empty( $c->paid_started_at ) ? $c->paid_started_at : null,
+				'member_days'       => $paid ? (int) $c->paid_days : 0,
+				'paid_is_member'    => 0,
+				'paid_started_at'   => null,
+				'paid_days'         => 0,
+			);
+		}
+		$ok = $wpdb->update( $ct, $row, array( 'id' => $c->id ) );
+		if ( $ok === false ) {
+			$wpdb->query( 'ROLLBACK' );
+			if ( $eid ) {
+				$wpdb->delete( self::t( 'events' ), array( 'id' => (int) $eid ) ); // MyISAM has no rollback
+			}
+			return vai_error( 'db_error', 'تعذّر حفظ العضوية الآن — أعد المحاولة', 500 );
