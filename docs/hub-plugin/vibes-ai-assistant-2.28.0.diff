+		if ( $a['action'] === 'extend' && $active && ! empty( $c->paid_started_at ) ) {
+			$ok = $wpdb->query( $wpdb->prepare( "UPDATE $ct SET paid_days=IF(paid_days>0, paid_days, %d)+%d WHERE id=%d", (int) $a['std'], (int) $a['days'], (int) $c->id ) );
+			return $ok === false ? '' : 'extend';
+		}
+		if ( $a['action'] === 'extend' && $active ) {
+			return 'open';
+		}
+		$ok = $wpdb->update( $ct, array( 'paid_is_member' => 1, 'paid_started_at' => vai_now(), 'paid_days' => (int) $a['days'] ), array( 'id' => $c->id ) );
+		return $ok === false ? '' : 'start';
+	}
+
+	/**
+	 * Give ($on) or take back the honorary membership. One transaction with the history row, like member_write().
+	 * Returns array( ok, event_id ) or a WP_Error (invalid 409 when there is nothing to change, db_error 500).
+	 */
+	public static function honorary_change( $contact_id, $on, $actor_id = 0, $note = '' ) {
+		global $wpdb;
+		$ct = self::t( 'contacts' );
+		$on = (bool) $on;
+		$wpdb->query( 'START TRANSACTION' );
+		$c = $wpdb->get_row( $wpdb->prepare( "SELECT * FROM $ct WHERE id=%d FOR UPDATE", (int) $contact_id ) );
+		if ( ! $c ) {
+			$wpdb->query( 'ROLLBACK' );
+			return vai_error( 'no_contact', 'الحساب غير موجود', 404 );
+		}
+		if ( self::is_honorary( $c ) === $on ) {
+			$wpdb->query( 'ROLLBACK' );
+			return vai_error( 'invalid', $on ? 'العضوية الشرفية ممنوحة لهذا الحساب من قبل' : 'هذا الحساب لا يحمل عضوية شرفية', 409 );
