+		if ( $on ) {
+			$row = array(
+				'honorary'          => 1,
+				'honorary_at'       => vai_now(),
+				'paid_is_member'    => (int) $c->is_member,
+				'paid_started_at'   => ! empty( $c->member_started_at ) ? $c->member_started_at : null,
+				'paid_days'         => (int) $c->member_days,
+				'is_member'         => 1,
+				'stage'             => 2,
+				'member_started_at' => null,
