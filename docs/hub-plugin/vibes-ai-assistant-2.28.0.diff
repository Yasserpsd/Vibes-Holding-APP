+	/** member_apply() for an honorary member: the same four branches, written to the kept paid clock. */
+	private static function member_apply_under_honorary( $c, array $a ) {
+		global $wpdb;
+		$ct = self::t( 'contacts' );
+		if ( $a['action'] === 'revoke' ) {
+			$ok = $wpdb->update( $ct, array( 'paid_is_member' => 0, 'paid_started_at' => null, 'paid_days' => 0 ), array( 'id' => $c->id ) );
