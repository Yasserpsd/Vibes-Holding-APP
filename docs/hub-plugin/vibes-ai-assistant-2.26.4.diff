+	public static function source_parts( $c ) {
+		$src  = isset( $c->source ) ? (string) $c->source : '';
+		$base = preg_replace( '/:(apple|google)$/', '', $src );
+		if ( 0 === strpos( $base, 'app-ios' ) ) {
+			$platform = 'تطبيق iPhone';
+		} elseif ( 0 === strpos( $base, 'app-android' ) ) {
+			$platform = 'تطبيق Android';
+		} elseif ( 'app' === $base ) {
+			$platform = 'التطبيق';
+		} elseif ( 'paypage' === $base || 'paymob' === $base ) {
+			$platform = 'صفحة الدفع';
+		} elseif ( 0 === strpos( $base, 'site:' ) ) {
+			$platform = 'موقع ' . substr( $base, 5 );
+		} else {
+			// No stored source (accounts before 2.21.1): the app server's own row is «التطبيق», never its host name.
+			$platform = ! empty( $c->site_trusted ) ? 'التطبيق' : ( ! empty( $c->host ) ? 'موقع ' . (string) $c->host : '—' );
+		}
+		$via = preg_match( '/:(apple|google)$/', $src, $m ) ? 'حساب ' . ( 'apple' === $m[1] ? 'Apple' : 'Google' ) : 'البريد الإلكتروني';
+		if ( isset( $c->referred_by ) && (int) $c->referred_by > 0 ) {
+			$ref  = self::contact( (int) $c->referred_by );
+			$via .= ' — دعوة من ' . ( $ref ? $ref->name : 'عضو' ) . ' (#' . (int) $c->referred_by . ')';
+		}
+		return array( 'platform' => $platform, 'via' => $via );
+	}
