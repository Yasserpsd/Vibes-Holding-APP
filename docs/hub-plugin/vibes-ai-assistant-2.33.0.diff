+	/* ───────────── Success Partners membership (2.33.0, app milestone M271) ─────────────
+	 * «عضوية شركاء النجاح»: given by the administration for 360 days, from the app dashboard only
+	 * (admin_grant: partner | partner_revoke). Nothing is sold and no client op reads a `partner` field.
+	 *
+	 * How it is stored: partner_at + partner_days are its own clock, and it runs while that clock does (is_partner()
+	 * reads the time, so nothing has to run on the day it ends). The paid clock he had (or buys later) is kept aside in
+	 * paid_*, like under the honorary membership. The live columns (member_started_at, member_days) always hold
+	 * WHICHEVER OF THE TWO ENDS LATER, so every gate, list, count and reminder needs no change, and a paid period that
+	 * outlasts the Success Partners year simply carries on when the year is over.
+	 */
+
+	/** UTC timestamp the Success Partners period ends, 0 when there is none. */
+	private static function partner_end_ts( $c ) {
+		if ( ! $c || empty( $c->partner_at ) || (int) $c->partner_days <= 0 ) {
+			return 0;
+		}
+		return strtotime( $c->partner_at . ' UTC' ) + (int) $c->partner_days * 86400;
+	}
+
+	/** Holds a Success Partners membership that is running now. */
+	public static function is_partner( $c ) {
+		return self::partner_end_ts( $c ) > time() && ! self::is_honorary( $c );
+	}
+
+	/** The four partner fields of the contact shapes: zeroes and empty strings when it is not running. */
+	public static function partner_fields( $c ) {
+		$on  = self::is_partner( $c );
+		$end = $on ? self::partner_end_ts( $c ) : 0;
+		return array(
+			'partner'       => $on ? 1 : 0,
+			'partner_since' => $on ? vai_riyadh( $c->partner_at, 'Y-m-d' ) : '',
+			'partner_end'   => $on ? vai_riyadh( gmdate( 'Y-m-d H:i:s', $end ), 'Y-m-d' ) : '',
+			'partner_left'  => $on ? (int) ceil( ( $end - time() ) / 86400 ) : null,
+		);
+	}
+
+	/** The live membership columns under a Success Partners period: the clock that ends later wins. */
+	private static function partner_main_clock( $partner_at, $partner_days, $paid_on, $paid_at, $paid_days ) {
+		$row = array( 'is_member' => 1, 'stage' => 2, 'member_started_at' => $partner_at, 'member_days' => (int) $partner_days );
+		if ( (int) $paid_on !== 1 ) {
+			return $row;
+		}
+		if ( empty( $paid_at ) ) { // a paid membership with no end date outlasts everything
+			$row['member_started_at'] = null;
+			$row['member_days']       = (int) $paid_days;
+			return $row;
+		}
+		$days = (int) $paid_days > 0 ? (int) $paid_days : (int) vai_cfg( 'member_days' );
+		if ( strtotime( $paid_at . ' UTC' ) + $days * 86400 > strtotime( $partner_at . ' UTC' ) + (int) $partner_days * 86400 ) {
+			$row['member_started_at'] = $paid_at;
+			$row['member_days']       = $days;
+		}
+		return $row;
+	}
+
+	/** After the kept paid clock changed under a Success Partners period: set the live columns again. */
+	private static function partner_sync( $contact_id ) {
