+		return $wpdb->update( self::t( 'contacts' ), $row, array( 'id' => $c->id ) ) !== false;
+	}
+
+	/**
+	 * Give ($on) or take back the Success Partners membership. One transaction with the history row, like member_write().
+	 * Returns array( ok, event_id ) or a WP_Error (honorary / invalid 409, db_error 500).
+	 */
+	public static function partner_change( $contact_id, $on, $actor_id = 0, $note = '' ) {
+		global $wpdb;
+		$ct = self::t( 'contacts' );
+		$on = (bool) $on;
+		$wpdb->query( 'START TRANSACTION' );
+		$c = $wpdb->get_row( $wpdb->prepare( "SELECT * FROM $ct WHERE id=%d FOR UPDATE", (int) $contact_id ) );
+		if ( ! $c ) {
+			$wpdb->query( 'ROLLBACK' );
+			return vai_error( 'no_contact', 'الحساب غير موجود', 404 );
+		}
+		if ( $on && self::is_honorary( $c ) ) {
+			$wpdb->query( 'ROLLBACK' );
+			return vai_error( 'honorary', 'هذا الحساب يحمل العضوية الشرفية: اسحبها أولًا لمنح عضوية شركاء النجاح', 409 );
+		}
+		if ( self::is_partner( $c ) === $on ) {
+			$wpdb->query( 'ROLLBACK' );
+			return vai_error( 'invalid', $on ? 'عضوية شركاء النجاح ممنوحة لهذا الحساب من قبل' : 'هذا الحساب لا يحمل عضوية شركاء النجاح', 409 );
+		}
+		$eid = self::insert_event( $c->id, $on ? 'partner' : 'partner_revoked', $on ? self::PARTNER_DAYS : 0, 'admin', '', (int) $actor_id, (string) $note );
+		if ( $on ) {
+			$now = vai_now();
+			$row = array_merge(
+				self::partner_main_clock( $now, self::PARTNER_DAYS, (int) $c->is_member, $c->member_started_at, (int) $c->member_days ),
+				array(
+					'partner_at'      => $now,
+					'partner_days'    => self::PARTNER_DAYS,
+					'paid_is_member'  => (int) $c->is_member,
+					'paid_started_at' => ! empty( $c->member_started_at ) ? $c->member_started_at : null,
+					'paid_days'       => (int) $c->member_days,
+				)
+			);
+		} else {
+			$row = array_merge( array( 'partner_at' => null, 'partner_days' => 0 ), self::kept_clock_back( $c ) );
+		}
+		$ok = $wpdb->update( $ct, $row, array( 'id' => $c->id ) );
+		if ( $ok === false ) {
+			$wpdb->query( 'ROLLBACK' );
+			if ( $eid ) {
+				$wpdb->delete( self::t( 'events' ), array( 'id' => (int) $eid ) ); // MyISAM has no rollback
+			}
+			return vai_error( 'db_error', 'تعذّر حفظ العضوية الآن — أعد المحاولة', 500 );
+		}
+		$wpdb->query( 'COMMIT' );
+		self::webhook( 'member.changed', array( 'contact_id' => (int) $c->id, 'kind' => $on ? 'partner' : 'partner_revoked' ) );
+		self::insert_message( $c->id, (int) $c->last_site_id, 'system', $on ? 'مُنحت عضوية شركاء النجاح ⭐ (' . self::PARTNER_DAYS . ' يومًا)' : 'سُحبت عضوية شركاء النجاح' );
+		return array( 'ok' => true, 'event_id' => (int) $eid );
+	}
