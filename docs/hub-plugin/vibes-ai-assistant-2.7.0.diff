+	/** Store purchase / renewal confirmed by the app server: contact_id, days, reference, product, store → ok, contact, already. */
+	private static function op_activate_member( $site, $d ) {
+		$c   = self::contact( isset( $d['contact_id'] ) ? (int) $d['contact_id'] : 0 );
+		$ref = self::clean_ref( vai_str( $d, 'reference', 150 ) );
+		if ( ! $c ) {
+			return vai_error( 'no_contact', 'الحساب غير موجود', 404 );
+		}
+		if ( $ref === '' ) {
+			return vai_error( 'invalid', 'مرجع عملية الشراء مطلوب', 400 );
+		}
+		$days = vai_int_in( $d, 'days', 1, 3660, (int) vai_cfg( 'member_days' ) );
+		$note = trim( preg_replace( '/[^a-z0-9._\-]/i', '', vai_str( $d, 'store', 20 ) ) . ' ' . preg_replace( '/[^a-z0-9._\-]/i', '', vai_str( $d, 'product', 80 ) ) );
+		$res  = self::member_change( $c->id, 'extend', $days, 'store', $ref, 0, $note );
+		if ( ! $res ) {
+			return vai_error( 'no_contact', 'الحساب غير موجود', 404 );
+		}
+		if ( ! empty( $res['conflict'] ) ) {
+			return vai_error( 'reference_used', 'مرجع عملية الشراء مسجّل لحساب آخر — لم يتغيّر شيء في هذا الحساب', 409 );
+		}
+		if ( empty( $res['ok'] ) ) {
+			return vai_error( 'db_error', 'تعذّر حفظ العضوية الآن — أعد المحاولة', 500 );
+		}
+		return array( 'ok' => true, 'contact' => self::public_contact( self::contact( $c->id ) ), 'already' => ! empty( $res['already'] ) );
+	}
