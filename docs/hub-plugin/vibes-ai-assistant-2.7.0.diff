+	/** Last 50 rows of a payments-like table (contact_id, email, phone) that belong to this person. */
+	private static function rows_of_person( $table, $c ) {
+		global $wpdb;
+		$where = array( 'contact_id=%d' );
+		$args  = array( (int) $c->id );
+		if ( $c->email !== '' ) {
+			$where[] = 'email=%s';
+			$args[]  = (string) $c->email;
+		}
+		if ( $c->phone_norm !== '' ) {
+			$where[] = 'phone=%s';
+			$args[]  = vai_phone_local( $c->phone_norm );
+		}
+		return (array) $wpdb->get_results( $wpdb->prepare( "SELECT * FROM $table WHERE (" . implode( ' OR ', $where ) . ') ORDER BY id DESC LIMIT 50', $args ) );
+	}
