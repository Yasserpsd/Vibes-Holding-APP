+/** Riyadh calendar day (Y-m-d) → UTC datetime string of that day's midnight. Riyadh is UTC+3 all year. */
+function vai_riyadh_day_utc( $day ) {
+	$t = strtotime( (string) $day . ' 00:00:00 UTC' );
+	return $t ? gmdate( 'Y-m-d H:i:s', $t - 3 * 3600 ) : vai_riyadh_day_start_utc();
+}
+
+/** Integer input clamped to a range (default when missing or not numeric). */
+function vai_int_in( $arr, $key, $min, $max, $default ) {
+	$v = isset( $arr[ $key ] ) && is_numeric( $arr[ $key ] ) ? (int) $arr[ $key ] : (int) $default;
+	return max( (int) $min, min( (int) $max, $v ) );
+}
