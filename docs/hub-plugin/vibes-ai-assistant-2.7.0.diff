+	/** contact_id => array( role, content ) of the last visible message, one query for the whole page. */
+	private static function bulk_last_messages( array $ids ) {
+		global $wpdb;
+		$out = array();
+		$ids = self::clean_ids( $ids );
+		if ( ! $ids ) {
+			return $out;
+		}
+		$mt   = self::t( 'messages' );
+		$ph   = implode( ',', array_fill( 0, count( $ids ), '%d' ) );
+		$rows = (array) $wpdb->get_results( $wpdb->prepare( "SELECT m.contact_id, m.role, m.content FROM $mt m INNER JOIN (SELECT MAX(id) AS mid FROM $mt WHERE contact_id IN ($ph) AND role IN ('user','assistant','human') GROUP BY contact_id) x ON x.mid=m.id", $ids ) );
+		foreach ( $rows as $r ) {
+			$out[ (int) $r->contact_id ] = array( 'role' => (string) $r->role, 'content' => (string) $r->content );
+		}
+		return $out;
+	}
+
+	/** One conversation, 40 messages per page, oldest first; «before» = the oldest message id already shown. */
+	private static function op_admin_thread( $site, $d ) {
+		global $wpdb;
+		$actor = self::bridge_actor( $site, $d );
+		if ( is_wp_error( $actor ) ) {
+			return $actor;
+		}
+		$c = self::contact_with_site( isset( $d['contact_id'] ) ? (int) $d['contact_id'] : 0 );
+		if ( ! $c ) {
+			return vai_error( 'no_contact', 'المحادثة غير موجودة', 404 );
+		}
+		$mt     = self::t( 'messages' );
+		$before = isset( $d['before'] ) ? (int) $d['before'] : 0;
+		$sql    = "SELECT id, role, content, page_url, meta, created_at FROM $mt WHERE contact_id=%d" . ( $before > 0 ? ' AND id<%d' : '' ) . ' ORDER BY id DESC LIMIT 41';
+		$rows   = (array) $wpdb->get_results( $wpdb->prepare( $sql, $before > 0 ? array( $c->id, $before ) : array( $c->id ) ) );
+		$more   = count( $rows ) > 40;
+		$msgs   = array();
+		$max    = (int) $c->admin_seen_id;
+		foreach ( array_reverse( array_slice( $rows, 0, 40 ) ) as $r ) {
+			$meta   = $r->meta ? json_decode( $r->meta, true ) : array();
+			$msgs[] = array(
+				'id'       => (int) $r->id,
+				'role'     => (string) $r->role,
+				'content'  => (string) $r->content,
+				'by'       => is_array( $meta ) && ! empty( $meta['by'] ) ? (string) $meta['by'] : '',
+				'page_url' => (string) $r->page_url,
+				'at'       => (string) $r->created_at,
+			);
+			$max    = max( $max, (int) $r->id );
+		}
+		if ( $before <= 0 && $max > (int) $c->admin_seen_id ) {
+			$wpdb->update( self::t( 'contacts' ), array( 'admin_seen_id' => $max ), array( 'id' => $c->id ) ); // opening the latest page marks it read, like the console
+		}
+		$accounts = self::account_rows( array( $c ) );
+		return array( 'ok' => true, 'account' => $accounts[0], 'messages' => $msgs, 'has_more' => $more );
+	}
