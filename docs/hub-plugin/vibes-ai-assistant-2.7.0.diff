+		}
+		$crow   = (array) $wpdb->get_row( self::prep( 'SELECT ' . implode( ', ', $sum ) . " FROM $ct c WHERE $base", $qa ), ARRAY_A );
+		$counts = array();
+		foreach ( $states as $k ) {
+			$counts[ $k ] = isset( $crow[ 'n_' . $k ] ) ? (int) $crow[ 'n_' . $k ] : 0;
+		}
+		$sql  = "SELECT c.*, s.host AS site_host FROM $ct c LEFT JOIN $st s ON s.id=c.last_site_id WHERE " . self::sql_state( $state ) . " AND $base ORDER BY c.last_at DESC, c.id DESC LIMIT %d OFFSET %d";
+		$rows = (array) $wpdb->get_results( $wpdb->prepare( $sql, array_merge( $qa, array( $per, $off ) ) ) );
+		return array( 'ok' => true, 'total' => $counts[ $state ], 'page' => $page, 'per_page' => $per, 'counts' => $counts, 'items' => self::account_rows( $rows ) );
