+		return 'DATE_ADD(c.member_started_at, INTERVAL IF(c.member_days>0, c.member_days, ' . max( 1, (int) vai_cfg( 'member_days' ) ) . ') DAY)';
+	}
+
+	/** SQL condition of one account state on contact alias c (no user input in here). */
+	private static function sql_state( $state ) {
+		$end = self::sql_member_end();
+		$map = array(
+			'all'       => "(c.stage>=1 OR c.verified=1 OR c.pass_hash<>'')",
+			'pending'   => "(c.pass_hash<>'' AND c.verified=0 AND c.is_member=0)",
+			'unpaid'    => '(c.verified=1 AND c.is_member=0)',
+			'member'    => '(c.is_member=1 AND (c.member_started_at IS NULL OR ' . $end . '>UTC_TIMESTAMP()))',
+			'expired'   => '(c.is_member=1 AND c.member_started_at IS NOT NULL AND ' . $end . '<=UTC_TIMESTAMP())',
+			'admin'     => "(c.role='admin')",
+			'publisher' => "(c.role='publisher')",
+			'lead'      => "(c.stage>=1 AND c.verified=0 AND c.pass_hash='' AND c.is_member=0)",
+		);
+		return isset( $map[ $state ] ) ? $map[ $state ] : $map['all'];
+	}
+
+	/** The same states in PHP, for one row. */
+	private static function account_state( $c ) {
 		if ( (int) $c->is_member ) {
-			return 9;
+			return self::member_active( $c ) ? 'member' : 'expired';
+		}
+		if ( (int) $c->verified ) {
+			return 'unpaid';
+		}
+		return ! empty( $c->pass_hash ) ? 'pending' : 'lead';
+	}
+
+	/** Search box → array( sql, args ) on contact alias c. */
+	private static function where_contact_q( $q ) {
+		global $wpdb;
+		if ( $q === '' ) {
+			return array( '', array() );
+		}
+		$like = '%' . $wpdb->esc_like( $q ) . '%';
+		return array( ' AND (c.name LIKE %s OR c.email LIKE %s OR c.phone LIKE %s OR c.phone_norm LIKE %s OR c.company LIKE %s)', array( $like, $like, $like, $like, $like ) );
+	}
+
+	private static function clean_ids( array $ids ) {
+		return array_values( array_unique( array_filter( array_map( 'intval', $ids ) ) ) );
+	}
+
+	/** contact_id => lead types, one query for the whole page (list ops never run a query per row). */
+	private static function bulk_lead_types( array $ids ) {
+		global $wpdb;
+		$out = array();
+		$ids = self::clean_ids( $ids );
+		if ( ! $ids ) {
+			return $out;
+		}
+		$lt   = self::t( 'leads' );
+		$ph   = implode( ',', array_fill( 0, count( $ids ), '%d' ) );
+		$rows = (array) $wpdb->get_results( $wpdb->prepare( "SELECT contact_id, ltype FROM $lt WHERE contact_id IN ($ph)", $ids ) );
+		foreach ( $rows as $r ) {
+			$out[ (int) $r->contact_id ][] = (string) $r->ltype;
+		}
+		return $out;
+	}
+
+	/** contact_id => assistant replies since Riyadh midnight, one query for the whole page. */
+	private static function bulk_replies_today( array $ids ) {
+		global $wpdb;
+		$out = array();
+		$ids = self::clean_ids( $ids );
+		if ( ! $ids ) {
+			return $out;
+		}
+		$mt   = self::t( 'messages' );
+		$ph   = implode( ',', array_fill( 0, count( $ids ), '%d' ) );
+		$args = array_merge( $ids, array( vai_riyadh_day_start_utc() ) );
+		$rows = (array) $wpdb->get_results( $wpdb->prepare( "SELECT contact_id, COUNT(*) AS n FROM $mt WHERE contact_id IN ($ph) AND role='assistant' AND created_at>=%s GROUP BY contact_id", $args ) );
+		foreach ( $rows as $r ) {
+			$out[ (int) $r->contact_id ] = (int) $r->n;
+		}
+		return $out;
+	}
+
+	/** Shape «Account» of the contract. $c may carry site_host from a JOIN. Times are UTC, member_end is a Riyadh day. */
+	private static function account_row( $c, array $types, $used_today ) {
+		$std   = (int) vai_cfg( 'member_days' );
+		$daily = (int) vai_cfg( 'member_daily' );
+		$days  = (int) $c->member_days > 0 ? (int) $c->member_days : $std;
+		$score = self::intent_calc( $c, $types );
+		return array(
+			'id'            => (int) $c->id,
+			'name'          => (string) $c->name,
+			'email'         => (string) $c->email,
+			'phone'         => vai_phone_local( $c->phone_norm ? $c->phone_norm : $c->phone ),
+			'state'         => self::account_state( $c ),
+			'role'          => (string) $c->role,
+			'persona'       => (string) $c->persona,
+			'job_title'     => (string) $c->job_title,
+			'company'       => (string) $c->company,
+			'city'          => (string) $c->city,
+			'created_at'    => (string) $c->created_at,
+			'verified_at'   => isset( $c->verified_at ) ? (string) $c->verified_at : '',
+			'last_at'       => (string) $c->last_at,
+			'last_login_at' => (string) $c->last_login_at,
+			'site'          => isset( $c->site_host ) ? (string) $c->site_host : '',
+			'msg_count'     => (int) $c->msg_count,
+			'is_member'     => self::member_active( $c ) ? 1 : 0,
+			'member_left'   => self::member_days_left( $c ),
+			'member_days'   => $days,
+			'member_end'    => ! empty( $c->member_started_at ) ? vai_riyadh( gmdate( 'Y-m-d H:i:s', strtotime( $c->member_started_at . ' UTC' ) + $days * 86400 ), 'Y-m-d' ) : '',
+			'never_expires' => ( (int) $c->is_member && empty( $c->member_started_at ) ) ? 1 : 0,
+			'daily_limit'   => $daily,
+			'daily_left'    => (int) $c->is_member ? max( 0, $daily - (int) $used_today ) : null,
+			'intent'        => $score,
+			'intent_label'  => self::intent_label( $score ),
+			'has_password'  => ! empty( $c->pass_hash ) ? 1 : 0,
+		);
+	}
+
+	/** Accounts of a list of contact rows, with intent and today's replies computed in two bulk queries. */
+	private static function account_rows( array $rows ) {
+		$ids = array();
+		foreach ( $rows as $r ) {
+			$ids[] = (int) $r->id;
+		}
+		$types = self::bulk_lead_types( $ids );
+		$used  = self::bulk_replies_today( $ids );
+		$out   = array();
+		foreach ( $rows as $r ) {
+			$id    = (int) $r->id;
+			$out[] = self::account_row( $r, isset( $types[ $id ] ) ? $types[ $id ] : array(), isset( $used[ $id ] ) ? $used[ $id ] : 0 );
+		}
+		return $out;
+	}
+
+	/** Server-to-server (Investors Club app): the account holder deletes their own account. Personal data and conversations are wiped; payment records stay. */
+	private static function op_delete_account( $site, $d ) {
+		global $wpdb;
+		list( $c ) = self::resolve_contact( $site, isset( $d['uuid'] ) ? $d['uuid'] : '', false );
+		if ( ! $c || empty( $c->pass_hash ) ) {
+			return vai_error( 'no_account', 'سجّل الدخول أولًا', 401 );
+		}
+		if ( self::too_many_attempts( 'delete_' . $c->id, 6 ) ) {
+			return vai_error( 'rate', 'محاولات كثيرة — حاول بعد قليل', 429 );
+		}
+		$pass = isset( $d['password'] ) && is_string( $d['password'] ) ? $d['password'] : '';
+		if ( $pass === '' || ! wp_check_password( $pass, $c->pass_hash ) ) {
+			return vai_error( 'bad_login', 'كلمة المرور غير صحيحة', 401 );
+		}
+		$label = $c->name . ' / ' . vai_phone_local( $c->phone_norm ? $c->phone_norm : $c->phone ) . ' / ' . $c->email . ( (int) $c->is_member ? ' (عضو مدفوع)' : '' ) . ' — من ' . ( $site ? $site->host : '' );
+		foreach ( array( 'messages', 'visitors', 'tokens', 'sessions', 'leads' ) as $t ) {
+			$wpdb->delete( self::t( $t ), array( 'contact_id' => $c->id ) );
+		}
+		if ( class_exists( 'VAI_Payments' ) ) {
+			$wpdb->delete( VAI_Payments::table(), array( 'contact_id' => $c->id ) ); // queued e-mails carry the name and address
+		}
+		$wpdb->update( self::t( 'contacts' ), self::wiped_contact(), array( 'id' => $c->id ) );
+		self::log_event( $c->id, 'deleted', 0, self::site_source( $site ), '', 0, $site ? $site->host : '' );
+		$emails = array_filter( array_map( 'trim', explode( ',', (string) vai_opt( 'notify_email', get_option( 'admin_email' ) ) ) ) );
+		foreach ( $emails as $e ) {
+			if ( is_email( $e ) ) {
+				self::mail( $e, '[Vibes AI] حذف حساب من التطبيق: ' . $c->name, "حذف العضو حسابه بنفسه من تطبيق نادي المستثمرين.\n\n" . $label . "\nالتاريخ: " . vai_riyadh( vai_now() ) . " (الرياض)\n\nحُذفت بياناته الشخصية ومحادثاته؛ سجلات الدفع محفوظة كما هي." );
+			}
+		}
+		return array( 'ok' => true );
+	}
