+	/** Shape «Lead» for lead rows (site_host joined); $contacts = contact_id => contact row, intent computed in bulk. */
+	private static function lead_rows( array $leads, array $contacts ) {
+		$types = self::bulk_lead_types( array_keys( $contacts ) );
