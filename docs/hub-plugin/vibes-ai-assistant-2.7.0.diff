+	/** [vai_feed kind="event" limit="6"] — kind: post | event | empty for both. Cached 60 s per site; silent when the hub is unreachable. */
+	public static function shortcode_feed( $atts ) {
+		$atts  = shortcode_atts( array( 'kind' => '', 'limit' => 6 ), $atts, 'vai_feed' );
+		$kind  = in_array( $atts['kind'], array( 'post', 'event' ), true ) ? $atts['kind'] : '';
+		$limit = max( 1, min( 12, (int) $atts['limit'] ) );
+		if ( ! self::connected() ) {
+			return '';
+		}
+		$key   = 'vai_feed_sc_' . ( $kind !== '' ? $kind : 'all' ) . '_' . $limit;
+		$items = get_transient( $key );
+		if ( ! is_array( $items ) ) {
+			$res   = self::client( 'feed', array( 'kind' => $kind, 'limit' => $limit ), 8 );
+			$items = ( ! is_wp_error( $res ) && ! empty( $res['items'] ) && is_array( $res['items'] ) ) ? $res['items'] : array();
+			set_transient( $key, $items, 60 );
+		}
+		if ( ! $items ) {
+			return '';
+		}
+		$html = self::feed_style() . '<div class="vai-feed" dir="rtl">';
+		foreach ( $items as $it ) {
+			$html .= self::feed_card( is_array( $it ) ? $it : array() );
+		}
+		return $html . '</div>';
+	}
+
+	private static function feed_card( array $it ) {
+		$title = isset( $it['title'] ) ? (string) $it['title'] : '';
+		if ( $title === '' ) {
+			return '';
+		}
+		$url   = isset( $it['url'] ) ? esc_url( (string) $it['url'] ) : '';
+		$img   = isset( $it['image'] ) ? esc_url( (string) $it['image'] ) : '';
+		$event = ( isset( $it['event'] ) && is_array( $it['event'] ) ) ? $it['event'] : array();
+		$meta  = array();
+		if ( ! empty( $event['date'] ) ) {
+			$meta[] = '📅 ' . esc_html( (string) $event['date'] );
+		}
+		if ( ! empty( $event['place'] ) ) {
+			$meta[] = '📍 ' . esc_html( (string) $event['place'] );
+		}
+		$open  = $url !== '' ? '<a href="' . $url . '">' : '';
+		$close = $url !== '' ? '</a>' : '';
+		$html  = '<article class="vai-feed-card" data-vai-ask="' . esc_attr( $title ) . '">';
+		if ( $img !== '' ) {
+			$html .= '<div class="vai-feed-img">' . $open . '<img src="' . $img . '" alt="' . esc_attr( $title ) . '" loading="lazy">' . $close . '</div>';
+		}
+		$html .= '<div class="vai-feed-body"><span class="vai-feed-kind">' . ( ( isset( $it['kind'] ) && $it['kind'] === 'event' ) ? 'فعالية' : 'جديد النادي' ) . '</span>';
+		$html .= '<h3 class="vai-feed-title">' . $open . esc_html( $title ) . $close . '</h3>';
+		if ( $meta ) {
+			$html .= '<p class="vai-feed-meta">' . implode( ' · ', $meta ) . '</p>';
+		}
+		if ( ! empty( $it['excerpt'] ) ) {
+			$html .= '<p class="vai-feed-text">' . esc_html( (string) $it['excerpt'] ) . '</p>';
+		}
+		if ( $url !== '' ) {
+			$html .= '<a class="vai-feed-more" href="' . $url . '">التفاصيل ←</a>';
+		}
+		return $html . '</div></article>';
+	}
+
+	/** The cards' own small stylesheet, printed once per page (the widget stylesheet is not loaded where the widget is hidden). */
+	private static function feed_style() {
+		static $done = false;
+		if ( $done ) {
+			return '';
+		}
+		$done = true;
+		return '<style>.vai-feed{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:18px;margin:18px 0;font-family:"IBM Plex Sans Arabic",system-ui,sans-serif}.vai-feed-card{background:#fff;border:1px solid #e6e4de;border-radius:14px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 2px 10px rgba(0,0,0,.05)}.vai-feed-img img{display:block;width:100%;height:170px;object-fit:cover}.vai-feed-body{padding:14px 16px 16px;display:flex;flex-direction:column;gap:6px;flex:1}.vai-feed-kind{align-self:flex-start;background:#7A611A;color:#fff;border-radius:6px;padding:1px 8px;font-size:12px}.vai-feed-title{margin:0;font-size:17px;line-height:1.5}.vai-feed-title a{color:#1d1b16;text-decoration:none}.vai-feed-meta{margin:0;color:#6b665c;font-size:13px}.vai-feed-text{margin:0;color:#3d3a33;font-size:14px;line-height:1.7}.vai-feed-more{margin-top:auto;color:#8a6f1f;font-weight:600;font-size:14px;text-decoration:none}</style>';
+	}
+
