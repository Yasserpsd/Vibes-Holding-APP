+	/* admin_stats — contract 1.4 */
+
+	private static function op_admin_stats( $site, $d ) {
+		$actor = self::bridge_actor( $site, $d );
+		if ( is_wp_error( $actor ) ) {
+			return $actor;
+		}
+		$days   = vai_int_in( $d, 'days', 7, 180, 30 );
+		$today  = vai_riyadh( vai_now(), 'Y-m-d' );
+		$first  = gmdate( 'Y-m-d', strtotime( $today . ' 00:00:00 UTC' ) - ( $days - 1 ) * 86400 );
+		$since  = vai_riyadh_day_utc( $first );
+		$series = self::stats_series( $first, $days, $since );
+		$last   = $series ? $series[ count( $series ) - 1 ] : array();
+		unset( $last['day'] );
+		return array(
+			'ok'           => true,
+			'generated_at' => vai_now(),
+			'tz'           => 'Asia/Riyadh',
+			'days'         => $days,
+			'totals'       => self::stats_totals(),
+			'today'        => $last,
+			'expiring'     => self::stats_expiring(),
+			'series'       => $series,
+			'per_site'     => self::stats_per_site( $since ),
+			'mail'         => class_exists( 'VAI_Payments' ) ? VAI_Payments::queue_stats() : array( 'pending' => 0, 'sent' => 0, 'failed' => 0 ),
+			'ai'           => self::stats_ai(),
+		);
+	}
+
+	private static function stats_totals() {
+		global $wpdb;
+		$ct  = self::t( 'contacts' );
+		$sql = 'SELECT COUNT(*) AS contacts'
+			. ', SUM(CASE WHEN ' . self::sql_state( 'lead' ) . ' THEN 1 ELSE 0 END) AS leads'
+			// accounts = members_active + members_expired + unpaid, always: someone who paid before confirming his e-mail is an account too
+			. ', SUM(CASE WHEN (c.verified=1 OR c.is_member=1) THEN 1 ELSE 0 END) AS accounts'
+			. ', SUM(CASE WHEN ' . self::sql_state( 'pending' ) . ' THEN 1 ELSE 0 END) AS pending_email'
+			. ', SUM(CASE WHEN ' . self::sql_state( 'unpaid' ) . ' THEN 1 ELSE 0 END) AS unpaid'
+			. ', SUM(CASE WHEN ' . self::sql_state( 'member' ) . ' THEN 1 ELSE 0 END) AS members_active'
+			. ', SUM(CASE WHEN ' . self::sql_state( 'expired' ) . ' THEN 1 ELSE 0 END) AS members_expired'
+			. ', SUM(CASE WHEN c.is_member=1 AND c.member_started_at IS NULL THEN 1 ELSE 0 END) AS members_no_expiry'
+			. ", SUM(CASE WHEN c.role='admin' AND c.admin_verified=1 THEN 1 ELSE 0 END) AS admins"
+			. ", SUM(CASE WHEN c.role='publisher' THEN 1 ELSE 0 END) AS publishers"
+			. " FROM $ct c";
+		$row = (array) $wpdb->get_row( $sql, ARRAY_A );
+		$out = array();
+		foreach ( array( 'contacts', 'leads', 'accounts', 'pending_email', 'unpaid', 'members_active', 'members_expired', 'members_no_expiry', 'admins', 'publishers' ) as $k ) {
+			$out[ $k ] = isset( $row[ $k ] ) ? (int) $row[ $k ] : 0;
+		}
+		return $out;
+	}
+
+	/** One row per Riyadh day (UTC+3), zero-filled, oldest first. */
+	private static function stats_series( $first, $days, $since ) {
+		global $wpdb;
+		$keys = array( 'signups', 'verified', 'activations', 'renewals', 'payments_count', 'payments_cents', 'conversations', 'messages', 'leads' );
+		$rows = array();
+		for ( $i = 0; $i < $days; $i++ ) {
+			$day          = gmdate( 'Y-m-d', strtotime( $first . ' 00:00:00 UTC' ) + $i * 86400 );
+			$rows[ $day ] = array_merge( array( 'day' => $day ), array_fill_keys( $keys, 0 ) );
+		}
+		$et  = self::t( 'events' );
+		$mt  = self::t( 'messages' );
+		$lt  = self::t( 'leads' );
+		$pt  = $wpdb->prefix . 'vai_payments';
+		$day = 'DATE(DATE_ADD(created_at, INTERVAL 3 HOUR))';
+		$rows = self::stats_fill( $rows, $wpdb->prepare( "SELECT $day AS d, SUM(CASE WHEN kind='registered' THEN 1 ELSE 0 END) AS signups, SUM(CASE WHEN kind='verified' THEN 1 ELSE 0 END) AS verified, SUM(CASE WHEN kind='activated' THEN 1 ELSE 0 END) AS activations, SUM(CASE WHEN kind='renewed' THEN 1 ELSE 0 END) AS renewals FROM $et WHERE created_at>=%s GROUP BY d", $since ), array( 'signups', 'verified', 'activations', 'renewals' ) );
+		$rows = self::stats_fill( $rows, $wpdb->prepare( "SELECT $day AS d, COUNT(*) AS payments_count, SUM(amount_cents) AS payments_cents FROM $pt WHERE created_at>=%s AND success=1 GROUP BY d", $since ), array( 'payments_count', 'payments_cents' ) );
+		$rows = self::stats_fill( $rows, $wpdb->prepare( "SELECT $day AS d, COUNT(DISTINCT CASE WHEN role='user' THEN contact_id END) AS conversations, SUM(CASE WHEN role IN ('user','assistant') THEN 1 ELSE 0 END) AS messages FROM $mt WHERE created_at>=%s GROUP BY d", $since ), array( 'conversations', 'messages' ) );
+		$rows = self::stats_fill( $rows, $wpdb->prepare( "SELECT $day AS d, COUNT(*) AS leads FROM $lt WHERE created_at>=%s GROUP BY d", $since ), array( 'leads' ) );
+		return array_values( $rows );
+	}
+
+	/** Copy the columns of one «GROUP BY day» query into the zero-filled series. */
+	private static function stats_fill( array $rows, $sql, array $cols ) {
+		global $wpdb;
+		foreach ( (array) $wpdb->get_results( $sql, ARRAY_A ) as $r ) {
+			$d = isset( $r['d'] ) ? (string) $r['d'] : '';
+			if ( ! isset( $rows[ $d ] ) ) {
+				continue;
+			}
+			foreach ( $cols as $k ) {
+				$rows[ $d ][ $k ] = isset( $r[ $k ] ) ? (int) $r[ $k ] : 0;
+			}
+		}
+		return $rows;
+	}
+
+	/** Active memberships that end within 7 / 30 days, and the soonest 20 of them. */
+	private static function stats_expiring() {
+		global $wpdb;
+		$ct    = self::t( 'contacts' );
+		$end   = self::sql_member_end();
+		$where = "c.is_member=1 AND c.member_started_at IS NOT NULL AND $end>UTC_TIMESTAMP() AND $end<=DATE_ADD(UTC_TIMESTAMP(), INTERVAL 30 DAY)";
+		$n     = (array) $wpdb->get_row( "SELECT COUNT(*) AS d30, SUM(CASE WHEN $end<=DATE_ADD(UTC_TIMESTAMP(), INTERVAL 7 DAY) THEN 1 ELSE 0 END) AS d7 FROM $ct c WHERE $where", ARRAY_A );
+		$rows  = (array) $wpdb->get_results( "SELECT c.id, c.name, c.phone, c.phone_norm, c.email, $end AS ends FROM $ct c WHERE $where ORDER BY ends ASC, c.id ASC LIMIT 20" );
+		$items = array();
+		foreach ( $rows as $r ) {
+			$items[] = array(
+				'id'         => (int) $r->id,
+				'name'       => (string) $r->name,
+				'phone'      => vai_phone_local( $r->phone_norm ? $r->phone_norm : $r->phone ),
+				'email'      => (string) $r->email,
+				'member_end' => vai_riyadh( $r->ends, 'Y-m-d' ),
+				'days_left'  => (int) ceil( ( strtotime( $r->ends . ' UTC' ) - time() ) / 86400 ),
+			);
+		}
+		return array( 'd7' => isset( $n['d7'] ) ? (int) $n['d7'] : 0, 'd30' => isset( $n['d30'] ) ? (int) $n['d30'] : 0, 'items' => $items );
+	}
+
+	private static function stats_per_site( $since ) {
+		global $wpdb;
+		$mt   = self::t( 'messages' );
+		$st   = self::t( 'sites' );
+		$rows = (array) $wpdb->get_results( $wpdb->prepare( "SELECT s.host, s.name, COUNT(DISTINCT CASE WHEN m.role='user' THEN m.contact_id END) AS conversations, SUM(CASE WHEN m.role IN ('user','assistant') THEN 1 ELSE 0 END) AS messages FROM $mt m LEFT JOIN $st s ON s.id=m.site_id WHERE m.created_at>=%s GROUP BY m.site_id, s.host, s.name ORDER BY conversations DESC", $since ) );
+		$out  = array();
+		foreach ( $rows as $r ) {
+			$out[] = array( 'host' => (string) $r->host, 'name' => (string) $r->name, 'conversations' => (int) $r->conversations, 'messages' => (int) $r->messages );
+		}
+		return $out;
+	}
+
+	private static function stats_ai() {
+		global $wpdb;
+		$mt  = self::t( 'messages' );
+		$ct  = self::t( 'contacts' );
+		$day = vai_riyadh_day_start_utc();
