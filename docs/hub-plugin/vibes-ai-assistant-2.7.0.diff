+	/* one brain: changes / publish / feed */
+
+	/**
+	 * What is new on the websites since a knowledge id. since_id 0 = the latest 30. Team notes and AI self-notes are never
+	 * returned; the catalog rows and the app's own posts only when asked for by kind.
+	 */
+	private static function op_changes( $site, $d ) {
+		global $wpdb;
+		$kt    = self::t( 'knowledge' );
+		$st    = self::t( 'sites' );
+		$since = isset( $d['since_id'] ) ? max( 0, (int) $d['since_id'] ) : 0;
+		$limit = vai_int_in( $d, 'limit', 1, 100, 30 );
+		$asked = ( isset( $d['kinds'] ) && is_array( $d['kinds'] ) ) ? $d['kinds'] : array();
+		$kinds = array();
+		foreach ( $asked as $k ) {
+			$k = is_string( $k ) ? preg_replace( '/[^a-z_]/', '', strtolower( $k ) ) : '';
+			if ( $k !== '' && $k !== 'note' ) {
+				$kinds[] = $k;
+			}
+		}
+		$kinds = array_slice( array_values( array_unique( $kinds ) ), 0, 20 );
+		if ( $kinds ) {
+			$where = 'k.kind IN (' . implode( ',', array_fill( 0, count( $kinds ), '%s' ) ) . ')';
+			$args  = $kinds;
+		} else {
+			$where = "k.kind NOT IN ('note','faq','service','app_post','app_event')";
+			$args  = array();
+		}
+		if ( $since > 0 ) {
+			$sql  = "SELECT k.id, k.url, k.title, k.kind, k.content, k.updated_at, s.host, s.name FROM $kt k LEFT JOIN $st s ON s.id=k.site_id WHERE $where AND k.id>%d ORDER BY k.id ASC LIMIT %d";
+			$rows = (array) $wpdb->get_results( $wpdb->prepare( $sql, array_merge( $args, array( $since, $limit ) ) ) );
+		} else {
+			$sql  = "SELECT k.id, k.url, k.title, k.kind, k.content, k.updated_at, s.host, s.name FROM $kt k LEFT JOIN $st s ON s.id=k.site_id WHERE $where ORDER BY k.id DESC LIMIT %d";
+			$rows = array_reverse( (array) $wpdb->get_results( $wpdb->prepare( $sql, array_merge( $args, array( min( 30, $limit ) ) ) ) ) );
+		}
+		$cursor = $since;
+		$items  = array();
+		foreach ( $rows as $r ) {
+			$cursor  = max( $cursor, (int) $r->id );
+			$items[] = array(
+				'id'         => (int) $r->id,
+				'host'       => (string) $r->host,
+				'site'       => (string) $r->name,
+				'url'        => (string) $r->url,
+				'title'      => (string) $r->title,
+				'kind'       => (string) $r->kind,
+				'excerpt'    => vai_clip( (string) $r->content, 300 ),
+				'updated_at' => (string) $r->updated_at,
+			);
+		}
+		return array( 'ok' => true, 'cursor' => $cursor, 'items' => $items );
+	}
+
+	/**
+	 * The app publishes (or edits, or removes) a post / event: it becomes a knowledge row of the calling site at once, so
+	 * the assistant knows it on every website, and a public card for feed / [vai_feed]. Admins and publishers only.
+	 */
+	private static function op_publish( $site, $d ) {
+		global $wpdb;
+		$actor = self::bridge_actor( $site, $d, array( 'admin', 'publisher' ) );
+		if ( is_wp_error( $actor ) ) {
+			return $actor;
+		}
+		$key = substr( preg_replace( '/[^A-Za-z0-9_\-]/', '', vai_str( $d, 'key', 80 ) ), 0, 64 );
+		if ( $key === '' ) {
+			return vai_error( 'invalid', 'معرّف المنشور مطلوب' );
+		}
+		$kt  = self::t( 'knowledge' );
+		$ft  = self::t( 'feed' );
+		$url = 'app://posts/' . $key;
+		$uh  = md5( $url );
+		$row = $wpdb->get_row( $wpdb->prepare( "SELECT id, hash FROM $kt WHERE site_id=%d AND url_hash=%s", $site->id, $uh ) );
+		if ( ! empty( $d['remove'] ) ) {
+			$wpdb->delete( $kt, array( 'site_id' => $site->id, 'url_hash' => $uh ) );
+			$wpdb->delete( $ft, array( 'site_id' => $site->id, 'pkey' => $key ) );
+			self::publish_done( $site );
+			return array( 'ok' => true, 'id' => $row ? (int) $row->id : 0, 'removed' => true );
+		}
+		$card = self::publish_card( $d );
+		if ( is_wp_error( $card ) ) {
+			return $card;
+		}
+		$text = $card['content'] . self::publish_facts( $card );
+		$data = array( 'site_id' => $site->id, 'url' => $url, 'url_hash' => $uh, 'title' => $card['title'], 'content' => $text, 'content_norm' => vai_norm_text( $card['title'] . ' ' . $text ), 'kind' => $card['kind'] === 'event' ? 'app_event' : 'app_post', 'hash' => md5( $card['title'] . '|' . $text ), 'sync_id' => '', 'updated_at' => vai_now() );
+		$kid = self::knowledge_put( $row, $data, ! $row || $row->hash !== $data['hash'] );
+		if ( ! $kid ) {
+			return vai_error( 'db_error', 'تعذّر حفظ المنشور الآن — أعد المحاولة', 500 );
+		}
+		self::publish_feed_row( $site, $key, $card, $kid, (int) $actor->id );
+		self::publish_done( $site );
+		return array( 'ok' => true, 'id' => $kid );
+	}
+
+	/** Validate and clean the body of publish → array( kind, title, content, url, image, date, place, online ) or WP_Error. */
+	private static function publish_card( $d ) {
+		// Plain text only: the card is public (feed, [vai_feed] on every site, the app), whatever the renderer escapes.
+		$title   = vai_clip( wp_strip_all_tags( vai_text_ok( $d, 'title', 600 ) ), 300 );
+		$content = trim( wp_strip_all_tags( vai_text_ok( $d, 'content', 20000 ) ) );
+		if ( $title === '' ) {
+			return vai_error( 'invalid', 'عنوان المنشور مطلوب' );
+		}
+		$ev   = isset( $d['event'] ) && is_array( $d['event'] ) ? $d['event'] : array();
+		$http = array( 'http', 'https' );
+		return array(
+			'kind'    => vai_str( $d, 'kind', 10 ) === 'event' ? 'event' : 'post',
+			'title'   => $title,
+			'content' => $content,
+			'url'     => esc_url_raw( vai_str( $d, 'url', 600 ), $http ),
+			'image'   => esc_url_raw( vai_str( $d, 'image', 600 ), $http ),
+			'date'    => vai_clip( wp_strip_all_tags( vai_text_ok( $ev, 'date', 80 ) ), 40 ),
+			'place'   => vai_clip( wp_strip_all_tags( vai_text_ok( $ev, 'place', 400 ) ), 190 ),
+			'online'  => esc_url_raw( vai_str( $ev, 'online_url', 600 ), $http ),
+		);
+	}
+
+	/** The facts the assistant needs beside the text: when, where, and the public link. */
+	private static function publish_facts( $card ) {
+		$lines = array();
+		if ( $card['kind'] === 'event' ) {
+			if ( $card['date'] !== '' ) {
+				$lines[] = 'الموعد: ' . $card['date'];
+			}
+			if ( $card['place'] !== '' ) {
+				$lines[] = 'المكان: ' . $card['place'];
+			}
+			if ( $card['online'] !== '' ) {
+				$lines[] = 'رابط الحضور عن بُعد: ' . $card['online'];
+			}
+		}
+		if ( $card['url'] !== '' ) {
+			$lines[] = 'الرابط: ' . $card['url'];
+		}
+		return $lines ? "\n\n" . implode( "\n", $lines ) : '';
+	}
+
+	private static function publish_feed_row( $site, $key, $card, $knowledge_id, $author_id ) {
+		global $wpdb;
+		$ft   = self::t( 'feed' );
+		$now  = vai_now();
+		$data = array( 'kind' => $card['kind'], 'title' => $card['title'], 'excerpt' => vai_clip( $card['content'], 300 ), 'url' => $card['url'], 'image' => $card['image'], 'event_date' => $card['date'], 'event_place' => $card['place'], 'event_online' => $card['online'], 'knowledge_id' => (int) $knowledge_id, 'author_id' => (int) $author_id, 'updated_at' => $now );
+		$id   = (int) $wpdb->get_var( $wpdb->prepare( "SELECT id FROM $ft WHERE site_id=%d AND pkey=%s", $site->id, $key ) );
+		if ( $id ) {
+			$wpdb->update( $ft, $data, array( 'id' => $id ) );
+			return;
+		}
+		$wpdb->insert( $ft, array_merge( $data, array( 'site_id' => (int) $site->id, 'pkey' => $key, 'created_at' => $now ) ) );
+	}
+
+	/** After a publish / remove: fresh counters, fresh feed cache, and knowledge.changed for the app server. */
+	private static function publish_done( $site ) {
+		global $wpdb;
+		$kt = self::t( 'knowledge' );
+		$wpdb->update( self::t( 'sites' ), array( 'knowledge_count' => (int) $wpdb->get_var( $wpdb->prepare( "SELECT COUNT(*) FROM $kt WHERE site_id=%d", $site->id ) ) ), array( 'id' => $site->id ) );
+		foreach ( array( 'all', 'post', 'event' ) as $k ) {
+			delete_transient( 'vai_feed_' . $k );
+		}
+		self::knowledge_changed( $site, 1 );
+	}
+
+	/** Public, read-only, cached 60 s: the cards every site shows through [vai_feed]. kind: post | event | (empty = both). */
+	private static function op_feed( $site, $d ) {
+		$kind  = vai_str( $d, 'kind', 10 );
+		$kind  = in_array( $kind, array( 'post', 'event' ), true ) ? $kind : 'all';
+		$limit = vai_int_in( $d, 'limit', 1, 12, 6 );
+		$items = get_transient( 'vai_feed_' . $kind );
+		if ( ! is_array( $items ) ) {
+			$items = self::feed_items( $kind );
+			set_transient( 'vai_feed_' . $kind, $items, 60 );
+		}
+		return array( 'ok' => true, 'items' => array_slice( $items, 0, $limit ) );
+	}
+
+	/** The newest 12 cards of a kind (the cache holds 12, feed slices to its limit). */
+	private static function feed_items( $kind ) {
+		global $wpdb;
+		$ft   = self::t( 'feed' );
+		$rows = $kind === 'all'
+			? (array) $wpdb->get_results( "SELECT * FROM $ft ORDER BY created_at DESC, id DESC LIMIT 12" )
+			: (array) $wpdb->get_results( $wpdb->prepare( "SELECT * FROM $ft WHERE kind=%s ORDER BY created_at DESC, id DESC LIMIT 12", $kind ) );
+		$out  = array();
+		foreach ( $rows as $r ) {
+			$out[] = array(
+				'key'     => (string) $r->pkey,
+				'kind'    => (string) $r->kind,
+				'title'   => (string) $r->title,
+				'excerpt' => (string) $r->excerpt,
+				'url'     => (string) $r->url,
+				'image'   => (string) $r->image,
+				'event'   => $r->kind === 'event' ? array( 'date' => (string) $r->event_date, 'place' => (string) $r->event_place, 'online_url' => (string) $r->event_online ) : null,
+				'at'      => (string) $r->created_at,
+			);
+		}
+		return $out;
+	}
+
+	/** contact_id => contact row, one query. */
+	private static function contacts_by_id( array $ids ) {
+		global $wpdb;
+		$out = array();
+		$ids = self::clean_ids( $ids );
