+	private static function op_admin_threads( $site, $d ) {
+		global $wpdb;
+		$actor = self::bridge_actor( $site, $d );
+		if ( is_wp_error( $actor ) ) {
+			return $actor;
+		}
+		$ct     = self::t( 'contacts' );
+		$mt     = self::t( 'messages' );
+		$st     = self::t( 'sites' );
+		$unread = "EXISTS (SELECT 1 FROM $mt u WHERE u.contact_id=c.id AND u.role='user' AND u.id>c.admin_seen_id)";
+		$where  = 'c.msg_count>0';
+		$filter = vai_str( $d, 'filter', 12 );
+		if ( $filter === 'waiting' ) {
+			$where .= ' AND c.awaiting_since IS NOT NULL';
+		} elseif ( $filter === 'human' ) {
+			$where .= ' AND c.human_until IS NOT NULL AND c.human_until>UTC_TIMESTAMP()';
+		} elseif ( $filter === 'unread' ) {
+			$where .= ' AND ' . $unread;
+		}
+		list( $qs, $qa )          = self::where_contact_q( vai_str( $d, 'q', 100 ) );
+		list( $page, $per, $off ) = self::bridge_page( $d );
+		$total = (int) $wpdb->get_var( self::prep( "SELECT COUNT(*) FROM $ct c WHERE $where$qs", $qa ) );
+		$rows  = (array) $wpdb->get_results( $wpdb->prepare( "SELECT c.*, s.host AS site_host, ($unread) AS is_unread FROM $ct c LEFT JOIN $st s ON s.id=c.last_site_id WHERE $where$qs ORDER BY c.last_at DESC, c.id DESC LIMIT %d OFFSET %d", array_merge( $qa, array( $per, $off ) ) ) );
+		$ids   = array();
+		foreach ( $rows as $r ) {
+			$ids[] = (int) $r->id;
+		}
+		$last  = self::bulk_last_messages( $ids );
+		$types = self::bulk_lead_types( $ids );
+		$items = array();
+		foreach ( $rows as $r ) {
+			$id      = (int) $r->id;
+			$score   = self::intent_calc( $r, isset( $types[ $id ] ) ? $types[ $id ] : array() );
+			$items[] = array(
+				'contact_id'   => $id,
+				'name'         => (string) $r->name,
+				'phone'        => vai_phone_local( $r->phone_norm ? $r->phone_norm : $r->phone ),
+				'site'         => (string) $r->site_host,
+				'last_text'    => isset( $last[ $id ] ) ? vai_clip( $last[ $id ]['content'], 140 ) : '',
+				'last_role'    => isset( $last[ $id ] ) ? $last[ $id ]['role'] : '',
+				'last_at'      => (string) $r->last_at,
+				'unread'       => (int) $r->is_unread ? 1 : 0,
+				'waiting'      => ! empty( $r->awaiting_since ) ? 1 : 0,
+				'human'        => ( ! empty( $r->human_until ) && strtotime( $r->human_until . ' UTC' ) > time() ) ? 1 : 0,
+				'is_member'    => self::member_active( $r ) ? 1 : 0,
+				'intent'       => $score,
+				'intent_label' => self::intent_label( $score ),
+			);
+		}
+		return array( 'ok' => true, 'total' => $total, 'page' => $page, 'per_page' => $per, 'items' => $items );
+	}
