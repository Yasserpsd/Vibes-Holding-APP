+	/** member ↔ publisher from the app dashboard (admin promotion stays on the hub page, it has its own code step). */
+	private static function op_admin_set_role( $site, $d ) {
+		$actor = self::bridge_actor( $site, $d );
+		if ( is_wp_error( $actor ) ) {
+			return $actor;
+		}
+		$res = self::set_role( isset( $d['contact_id'] ) ? (int) $d['contact_id'] : 0, vai_str( $d, 'role', 12 ), 'admin', (int) $actor->id );
+		if ( is_wp_error( $res ) ) {
