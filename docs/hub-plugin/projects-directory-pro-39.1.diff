--- pb/inc/brief.php	1970-01-01 03:00:00.000000000 +0300
+++ work/pb/inc/brief.php	2026-09-22 01:17:44.746176600 +0300
@@ -0,0 +1,363 @@
+<?php
+/**
+ * v39.1 — «جدول المستشار»: the adviser's own table in place of the founder's description on the project page
+ * (owner, 2026-09-22: the project is shown alone — the app's «ملخص المستشار» is the model).
+ *
+ *  - Built from the project's own published fields only: no AI call, no request to any server, nothing stored but a
+ *    small per-project cache of the stage reading.
+ *  - Never in it: the founder's name, contact data, funding sought, valuation, equity on offer, promised returns.
+ *  - The site's stage «اخري / أخرى» is not a stage. The adviser reads the step from what the description says already
+ *    exists (plans never count) and marks it «تقدير المستشار»; a project it cannot read shows no stage at all.
+ *  - Setting «صفحة المشروع» in the plugin settings: table (default) | both (table, then the founder's text) | off.
+ */
+if (!defined('ABSPATH')) exit;
+
+// ========== R1. Text helpers ==========
+function pdp_brief_lower($s) { return function_exists('mb_strtolower') ? mb_strtolower((string)$s, 'UTF-8') : strtolower((string)$s); }
+function pdp_brief_len($s) { return function_exists('mb_strlen') ? mb_strlen((string)$s, 'UTF-8') : strlen((string)$s); }
+function pdp_brief_cut($s, $n) {
+    $s = trim(preg_replace('/\s+/u', ' ', (string)$s));
+    if (pdp_brief_len($s) <= $n) return $s;
+    $cut = function_exists('mb_substr') ? mb_substr($s, 0, $n, 'UTF-8') : substr($s, 0, $n);
+    $sp = function_exists('mb_strrpos') ? mb_strrpos($cut, ' ', 0, 'UTF-8') : strrpos($cut, ' ');
+    if ($sp !== false && $sp > $n * 0.6) $cut = function_exists('mb_substr') ? mb_substr($cut, 0, $sp, 'UTF-8') : substr($cut, 0, $sp);
+    return rtrim($cut, " ،,.;:") . '…';
+}
+/** Lowercase and fold the common Arabic spelling variants, punctuation to spaces (same folding as the app server). */
+function pdp_brief_fold($s) {
+    $s = pdp_brief_lower($s);
+    $s = preg_replace('/[\x{064B}-\x{0652}\x{0670}\x{0640}]/u', '', $s);
+    $s = preg_replace('/[أإآٱ]/u', 'ا', (string)$s);
+    $s = str_replace(['ى', 'ئ', 'ؤ', 'ة'], ['ي', 'ي', 'و', 'ه'], (string)$s);
+    $s = preg_replace('/[^\p{L}\p{N}\s]+/u', ' ', (string)$s);
+    return trim(preg_replace('/\s+/u', ' ', (string)$s));
+}
+function pdp_brief_plain($html) {
+    $t = html_entity_decode(wp_strip_all_tags((string)$html), ENT_QUOTES, 'UTF-8');
+    return trim(preg_replace('/[ \t]+/u', ' ', str_replace(["\r\n", "\r"], "\n", $t)));
+}
+
+// ========== R2. The five steps and the stage reading ==========
+function pdp_brief_steps() {
+    return [
+        ['key' => 'idea',      'ar' => 'فكرة',              'en' => 'Idea',                 'match' => '/فكر|دراس|idea|concept/u'],
+        ['key' => 'prototype', 'ar' => 'تأسيس ونموذج أولي', 'en' => 'Founding & prototype', 'match' => '/تاسيس|نموذج|اولي|تجريب|تطوير|prototype|mvp|(?<!pre )seed/u'],
+        ['key' => 'launch',    'ar' => 'إطلاق وتشغيل',      'en' => 'Launch & operation',   'match' => '/اطلاق|تشغيل|قايم|بدايه|launch|operat|early/u'],
+        ['key' => 'revenue',   'ar' => 'تحقيق الدخل',       'en' => 'Revenue',              'match' => '/دخل|ايراد|مبيعات|cash|revenue/u'],
+        ['key' => 'growth',    'ar' => 'نمو وتوسع',         'en' => 'Growth & expansion',   'match' => '/نمو|توسع|انتشار|نضج|growth|scale|expan|mature/u'],
+    ];
+}
+/** 0-based step of a stage wording, -1 when it names none («اخري», empty). The furthest matching step wins. */
+function pdp_brief_step_of($name) {
+    $folded = pdp_brief_fold($name);
+    $index = -1;
+    if ($folded === '') return $index;
+    foreach (pdp_brief_steps() as $i => $step) { if (preg_match($step['match'], $folded)) $index = $i; }
+    return $index;
+}
+/** The step a description shows TODAY, -1 when it does not say. A clause about tomorrow is skipped. */
+function pdp_brief_estimate_step($details) {
+    $plans = '/نخطط|نسعي|نهدف|نطمح|نستهدف|نتطلع|نتوقع|متوقع|توقعات|سوف|سنقوم|سيتم|سنطلق|مستقبل|القادم|خطه|خطط|رويه|رويتنا|هدف|اهداف|يهدف|تهدف|يسعي|تسعي|نحتاج|بحاجه|aim|plan|will|goal|vision|future|expect|seek|need/u';
+    $evidence = [
+        '/فكره|دراسه جدوي|قيد الدراسه|idea|concept|feasibility/u',
+        '/نموذج اولي|النموذج الاولي|قيد التطوير|تحت التطوير|قيد الانشاء|تحت الانشاء|قيد التاسيس|تحت التاسيس|نسخه تجريبيه|مرحله تجريبيه|mvp|prototype|beta|under development/u',
+        '/تم اطلاق|تم الاطلاق|اطلقنا|تم تشغيل|تم التشغيل|يعمل حاليا|تعمل حاليا|نعمل حاليا|قايم حاليا|شركه قايمه|مشروع قايم|تم افتتاح|افتتحنا|مستخدم مسجل|شركه مسجله|شركات مسجله|عميل مسجل|launched|operating|is live|registered users/u',
+        '/حققنا|حققت ايرادات|حققت مبيعات|حقق ايرادات|حقق مبيعات|ايراداتنا|مبيعاتنا|ايرادات سنويه|ايرادات شهريه|مبيعات سنويه|مبيعات شهريه|عملاء يدفعون|دخل شهري|دخل سنوي|revenue of|in revenue|paying customers|annual sales/u',
+        '/توسعنا|تم التوسع|افتتحنا فرع|فروعنا|عده فروع|اكثر من فرع|فرعا في|اسواق جديده دخلناها|expanded to|branches in/u',
+    ];
+    $index = -1;
+    $clauses = preg_split('/[.!?؟؛\n،]+|,(?!\d)|\sبينما\s/u', (string)$details);
+    foreach ((array)$clauses as $clause) {
+        $folded = pdp_brief_fold($clause);
+        if ($folded === '' || preg_match($plans, $folded)) continue;
+        foreach ($evidence as $i => $rx) { if ($i > $index && preg_match($rx, $folded)) $index = $i; }
+    }
+    return $index;
+}
+/** array( index, estimated ) of a project: the site's stage, else the adviser's reading (cached per description), else -1. */
+function pdp_brief_project_step($pid) {
+    $pid = (int)$pid;
+    $terms = get_the_terms($pid, 'project_stage');
+    $name = ($terms && !is_wp_error($terms) && !empty($terms[0])) ? (string)$terms[0]->name : '';
+    $declared = pdp_brief_step_of($name);
+    if ($declared >= 0) return [$declared, false];
+    $details = pdp_brief_plain(get_post_meta($pid, 'project_details', true));
+    $sig = md5($details);
+    $cached = (string)get_post_meta($pid, '_pdp_stage_est', true);
+    if ($cached !== '' && strpos($cached, $sig . ':') === 0) return [(int)substr($cached, 33), true];
+    $est = pdp_brief_estimate_step($details);
+    update_post_meta($pid, '_pdp_stage_est', $sig . ':' . $est);
+    return [$est, true];
+}
+/**
+ * The stage as the visitor sees it, everywhere on the site. A declared stage keeps the site's own wording; «اخري» becomes
+ * the adviser's reading («إطلاق وتشغيل · تقدير المستشار») or an empty string (no tag at all).
+ */
+function pdp_stage_display($pid, $lang = 'ar') {
+    $terms = get_the_terms((int)$pid, 'project_stage');
+    $name = ($terms && !is_wp_error($terms) && !empty($terms[0])) ? (string)$terms[0]->name : '';
+    if ($name !== '' && pdp_brief_step_of($name) >= 0) return function_exists('pdp_translate_term') ? pdp_translate_term($name, 'stage', $lang) : $name;
+    list($index, ) = pdp_brief_project_step($pid);
+    $steps = pdp_brief_steps();
+    if ($index < 0 || !isset($steps[$index])) return '';
+    return $lang === 'en' ? $steps[$index]['en'] . ' · adviser\'s estimate' : $steps[$index]['ar'] . ' · تقدير المستشار';
+}
+
+// ========== R3. What may be lifted from the founder's text ==========
+/** A clause the table must not repeat: contact data, the ask (funding, valuation, equity), returns or guarantees. */
+function pdp_brief_blocked($text) {
+    $raw = (string)$text;
+    if (preg_match('/[\w.+-]+@[\w-]+\.[\w.-]+|https?:\/\/|www\.|(?<![\w.])@[\w.]{3,}|(?:\+|00)?[\d٠-٩][\d٠-٩\s\-()]{7,}[\d٠-٩]/u', $raw)) return true;
+    $f = pdp_brief_fold($raw);
+    return (bool)preg_match('/واتس|جوال|هاتف|للتواصل|تواصل معنا|ايميل|البريد|انستقرام|تويتر|سناب|whats|phone|email|تمويل|استثمار|مستثمر|راس المال|راس مال|راسمال|حصه|حصص|تقييم|جوله|ريال|دولار|درهم|جنيه|مليون|مليار|sar|usd|funding|invest|valuation|equity|capital|عايد|عوايد|ارباح|ربح|roi|return|profit|مضمون|نضمن|يضمن|ضمان|بلا مخاطر|بدون مخاطر|guarantee|risk free|الموسس|موسس|المالك|founder|owner/u', $f);
+}
+/** The club's wording rules on text we author or lift. */
+function pdp_brief_wording($s) {
+    $s = preg_replace('/مجان(?:ًا|اً|ا|ية|ي)?/u', 'بدون رسوم', (string)$s);
+    $s = str_replace('كريديت', 'رصيد', (string)$s);
+    $s = preg_replace('/(\d)\s*-\s*(\d)/u', '$1–$2', (string)$s);
+    return trim(preg_replace('/\s+/u', ' ', (string)$s));
+}
+function pdp_brief_summary($excerpt, $details, $fallback) {
+    foreach ([$excerpt, $details] as $source) {
+        $keep = [];
+        $size = 0;
+        foreach ((array)preg_split('/(?<=[.!?؟])\s+|\n+/u', pdp_brief_plain($source)) as $sentence) {
+            $sentence = trim((string)$sentence);
+            if (preg_match('/^[\s•\-–*]*[^:：\n]{2,40}[:：]\s*.{2,160}$/u', $sentence)) continue; // a «label: value» line belongs to the table
+            if (pdp_brief_len($sentence) < 25 || pdp_brief_blocked($sentence)) continue;
+            $keep[] = $sentence;
+            $size += pdp_brief_len($sentence);
+            if ($size >= 300 || count($keep) >= 3) break;
+        }
+        if ($keep) return pdp_brief_cut(pdp_brief_wording(implode(' ', $keep)), 420);
+    }
+    return $fallback;
+}
+/** «label: value» lines the founder wrote, minus anything blocked. */
+function pdp_brief_written_rows($details, $taken) {
+    $rows = [];
+    foreach (explode("\n", pdp_brief_plain($details)) as $line) {
+        if (!preg_match('/^[\s•\-–*]*([^:：\n]{2,40})[:：]\s*(.{2,160})$/u', trim($line), $m)) continue;
+        $label = pdp_brief_wording($m[1]);
+        $value = pdp_brief_wording($m[2]);
+        if ($label === '' || $value === '' || isset($taken[$label]) || pdp_brief_blocked($label . ' ' . $value)) continue;
+        $taken[$label] = true;
+        $rows[] = [$label, $value];
+        if (count($rows) >= 6) break;
+    }
+    return $rows;
+}
+
+/** «5 سبتمبر 2026» / «September 5, 2026» in the site's timezone, whatever language WordPress itself runs in. */
+function pdp_brief_day($timestamp, $en) {
+    if ($timestamp <= 0) return '';
+    $months_ar = ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'];
+    $months_en = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
+    $parts = explode('-', wp_date('Y-n-j', $timestamp));
+    if (count($parts) !== 3) return '';
+    $month = (int)$parts[1] - 1;
+    return $en ? $months_en[$month] . ' ' . (int)$parts[2] . ', ' . $parts[0] : (int)$parts[2] . ' ' . $months_ar[$month] . ' ' . $parts[0];
+}
+
+// ========== R4. The brief ==========
+function pdp_brief_build($pid, $lang = 'ar') {
+    $pid = (int)$pid;
+    $en = ($lang === 'en');
+    $title = html_entity_decode(get_the_title($pid), ENT_QUOTES, 'UTF-8');
+    $title_en = (string)get_post_meta($pid, 'title_en', true);
+    $company = (string)get_post_meta($pid, $en ? 'company_name_en' : 'company_name', true);
+    if ($en && $company === '') $company = (string)get_post_meta($pid, 'company_name', true);
+    $details_ar = (string)get_post_meta($pid, 'project_details', true);
+    $details = $en ? ((string)get_post_meta($pid, 'project_details_en', true) ?: $details_ar) : $details_ar;
+    $excerpt = $en ? (string)get_post_meta($pid, 'excerpt_en', true) : (string)get_post_field('post_excerpt', $pid);
+    $golden = get_post_meta($pid, 'is_featured', true) === '1';
+    $pitch = (int)get_post_meta($pid, 'pitch_deck', true) > 0;
+    $sectors = get_the_terms($pid, 'sector');
+    $sector = ($sectors && !is_wp_error($sectors) && !empty($sectors[0])) ? (function_exists('pdp_translate_term') ? pdp_translate_term($sectors[0]->name, 'sector', $lang) : $sectors[0]->name) : '';
+    $number = (string)get_post_meta($pid, 'project_number', true);
+    list($index, $estimated) = pdp_brief_project_step($pid);
+    $steps = pdp_brief_steps();
+    $stage_label = pdp_stage_display($pid, $lang);
+    $plain_len = pdp_brief_len(pdp_brief_plain($details));
+
+    $facts = [
+        [$en ? 'Project no.' : 'رقم المشروع', $number !== '' ? '#' . $number : ''],
+        [$en ? 'Company' : 'الشركة', $company],
+        [$en ? 'Sector' : 'القطاع', $sector],
+        [$en ? 'Stage' : 'المرحلة', $stage_label],
+        [$en ? 'Type' : 'النوع', $golden ? ($en ? 'Golden project (V mark)' : 'مشروع ذهبي (علامة V)') : ($en ? 'Projects Bank project' : 'مشروع في بنك المشاريع')],
+        [$en ? 'Pitch deck' : 'ملف العرض', ($pitch && !$golden) ? ($en ? 'Available to members after unlocking the project' : 'متاح للأعضاء بعد فتح المشروع') : ($en ? 'Not attached' : 'غير مرفق')],
+        [$en ? 'Last update' : 'آخر تحديث', pdp_brief_day((int)get_post_modified_time('U', true, $pid), $en)],
+    ];
+    $rows = [];
+    $taken = [];
+    foreach ($facts as $fact) { if (trim((string)$fact[1]) !== '') { $rows[] = [$fact[0], pdp_brief_wording($fact[1])]; $taken[$fact[0]] = true; } }
+    $rows = array_merge($rows, pdp_brief_written_rows($details, $taken));
+
+    $shown_title = ($en && $title_en !== '') ? $title_en : $title;
+    $fallback = $en ? $shown_title . ($sector !== '' ? ': a project in ' . $sector . '.' : '.') : $shown_title . ($sector !== '' ? ': مشروع في قطاع ' . $sector . '.' : '.');
+
+    $strengths = [];
+    if ($plain_len >= 400) $strengths[] = $en ? 'A detailed description of the idea and the business model' : 'وصف تفصيلي يشرح فكرة المشروع ونموذج عمله';
+    if ($pitch && !$golden) $strengths[] = $en ? 'A pitch deck is available to members after unlocking the project' : 'ملف عرض (Pitch Deck) متاح للأعضاء بعد فتح المشروع';
+    if ($golden) $strengths[] = $en ? 'A golden project carrying the V mark of the ecosystem\'s companies' : 'مشروع ذهبي يحمل علامة V من شركات المنظومة';
+    if ($index >= 3 && !$estimated) $strengths[] = $en ? 'Past the launch stage according to its owner\'s data' : 'تجاوز مرحلة الإطلاق بحسب بيانات صاحبه';
+    if (!$strengths) $strengths[] = $en ? 'Its data is published in the Projects Bank and the adviser can answer questions about it' : 'بياناته منشورة في بنك المشاريع ويمكن سؤال المستشار عن تفاصيلها';
+
+    $notes = [$en ? 'The information comes from the project owner and was not independently reviewed' : 'المعلومات مقدمة من صاحب المشروع ولم تُراجَع بشكل مستقل'];
+    if ($index < 0) $notes[] = $en ? 'The project\'s stage is not stated in its data' : 'مرحلة المشروع غير محددة في بياناته';
+    elseif ($index <= 1) $notes[] = $en ? 'An early-stage project whose model is not proven in the market yet' : 'المشروع في مرحلة مبكرة ولم يثبت نموذجه في السوق بعد';
+    if ($plain_len < 200) $notes[] = $en ? 'The published description is short; ask for fuller details before any decision' : 'الوصف المنشور مختصر؛ اطلب تفاصيل أوفى قبل أي قرار';
+    if (!$pitch) $notes[] = $en ? 'No pitch deck attached' : 'لا يوجد ملف عرض مرفق';
+
+    return [
+        'title'      => $shown_title,
+        'summary'    => pdp_brief_summary($excerpt, $details, $fallback),
+        'rows'       => $rows,
+        'steps'      => array_map(function ($s) use ($en) { return $en ? $s['en'] : $s['ar']; }, $steps),
+        'index'      => $index,
+        'estimated'  => (bool)$estimated && $index >= 0,
+        'stage'      => $stage_label,
+        'strengths'  => $strengths,
+        'notes'      => $notes,
+        'disclaimer' => $en ? 'An automatic brief built from the project\'s published data in the Projects Bank. Informational only: not a contractual offer and no guarantee of returns.' : 'ملخص آلي من بيانات المشروع المنشورة في بنك المشاريع. المعلومات تعريفية وليست عرضًا تعاقديًا أو ضمانًا لعوائد.',
+    ];
+}
+
+function pdp_brief_mode() {
+    $m = (string)get_option('pdp_brief_mode', 'table');
+    return in_array($m, ['table', 'both', 'off'], true) ? $m : 'table';
+}
+
+/** The block that takes the place of «تفاصيل المشروع» on the project page. */
+function pdp_brief_render($pid, $lang = 'ar') {
+    $b = pdp_brief_build($pid, $lang);
+    $en = ($lang === 'en');
+    $known = $b['index'] >= 0 && $b['index'] < count($b['steps']);
+    ob_start();
+    ?>
+    <div class="sp-brief" id="spBrief">
+        <h2 class="sp-brief-t"><span class="sp-brief-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.6a1 1 0 01.7.3l5.4 5.4a1 1 0 01.3.7V19a2 2 0 01-2 2z"/></svg></span><?php echo esc_html($en ? 'Adviser\'s brief' : 'ملخص المستشار'); ?></h2>
+        <p class="sp-brief-sum"><?php echo esc_html($b['summary']); ?></p>
+
+        <div class="sp-brief-tbl" role="table">
+            <?php foreach ($b['rows'] as $row): ?>
+            <div class="sp-brief-row" role="row"><span class="sp-brief-l" role="rowheader"><?php echo esc_html($row[0]); ?></span><span class="sp-brief-v" role="cell"><?php echo esc_html($row[1]); ?></span></div>
+            <?php endforeach; ?>
+        </div>
+
+        <div class="sp-brief-stage">
+            <div class="sp-brief-h"><?php echo esc_html($en ? 'Where the project stands' : 'موقع المشروع على المراحل'); ?><?php if ($known): ?><span class="sp-brief-pill"><?php echo esc_html($b['steps'][$b['index']]); ?></span><?php endif; ?></div>
+            <ol class="sp-brief-steps">
+                <?php foreach ($b['steps'] as $i => $label): $cls = $known ? ($i < $b['index'] ? ' is-done' : ($i === $b['index'] ? ' is-now' : '')) : ''; ?>
+                <li class="sp-brief-step<?php echo esc_attr($cls); ?>"<?php echo ($known && $i === $b['index']) ? ' aria-current="step"' : ''; ?>><span class="sp-brief-dot" aria-hidden="true"></span><span class="sp-brief-sl"><?php echo esc_html($label); ?></span></li>
+                <?php endforeach; ?>
+            </ol>
+            <?php if (!$known): ?><p class="sp-brief-note"><?php echo esc_html($en ? 'The published data does not place the project on the stages.' : 'لم نتمكن من تحديد موقع المشروع على المراحل من بياناته المنشورة.'); ?></p>
+            <?php elseif ($b['estimated']): ?><p class="sp-brief-note"><?php echo esc_html($en ? 'The adviser\'s estimate from the project\'s description; its owner did not state the stage.' : 'تقدير المستشار من وصف المشروع؛ صاحب المشروع لم يحدد مرحلته.'); ?></p><?php endif; ?>
+        </div>
+
+        <div class="sp-brief-cols">
+            <div class="sp-brief-col"><div class="sp-brief-h"><?php echo esc_html($en ? 'Strengths' : 'نقاط القوة'); ?></div><ul><?php foreach ($b['strengths'] as $line): ?><li><?php echo esc_html($line); ?></li><?php endforeach; ?></ul></div>
+            <div class="sp-brief-col sp-brief-col-n"><div class="sp-brief-h"><?php echo esc_html($en ? 'Worth a closer look' : 'نقاط تستحق الانتباه'); ?></div><ul><?php foreach ($b['notes'] as $line): ?><li><?php echo esc_html($line); ?></li><?php endforeach; ?></ul></div>
+        </div>
