+    .pdp-overlay-btn-main.pdp-ask-btn{background:rgba(255,255,255,.1);border:1px solid rgba(240,215,140,.65);color:#f0d78c!important}.pdp-overlay-btn-main.pdp-ask-btn:hover{background:rgba(240,215,140,.18)}
+    .sp-btn.pdp-ask-btn{background:#1D2D51;color:#f0d78c!important}.sp-btn.pdp-ask-btn:hover{background:#0f1829;transform:translateY(-3px);box-shadow:0 10px 30px rgba(29,45,81,.35)}
+    </style>
+    <script>
+    (function(){'use strict';
+    var L=<?php echo wp_json_encode($cfg); ?>;
+    var ICON='<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>';
+    function ready(){return !!(window.VAI&&typeof window.VAI.ask==='function')}
+    function txt(el){return el?String(el.textContent||'').replace(/\s+/g,' ').trim():''}
+    function fill(s,o){return String(s).replace(/\{(\w+)\}/g,function(m,k){return o[k]!=null?o[k]:''}).replace(/\s+/g,' ').trim()}
+    /* public card fields only: title, number, sector, stage, the visible excerpt */
+    function cardCtx(card){var title=txt(card.querySelector('.pdp-card-title'));if(!title)return null;
+      var num=txt(card.querySelector('.pdp-pn-v')),sec=txt(card.querySelector('.pdp-tag-sector')),stg=txt(card.querySelector('.pdp-tag-stage')),sum=txt(card.querySelector('.pdp-card-excerpt'));
+      if(num)num=String(parseInt(num,10)||num);
