+      b.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();ask(getCtx())});return b}
+    function scan(){if(!ready())return;
+      document.querySelectorAll('.pdp-project-card').forEach(function(card){var get=function(){return cardCtx(card)};
+        var acts=card.querySelector('.pdp-card-actions');if(acts&&!acts.querySelector('.pdp-ask-btn'))acts.appendChild(mk('pdp-action-btn',get));
+        var ov=card.querySelector('.pdp-share-overlay .pdp-main-actions');if(ov&&!ov.querySelector('.pdp-ask-btn'))ov.appendChild(mk('pdp-overlay-btn-main',get))});
+      var sp=document.querySelector('.sp-acts');if(sp&&L.single&&!sp.querySelector('.pdp-ask-btn'))sp.appendChild(mk('sp-btn',function(){return L.single}))}
+    /* the buttons exist only once the widget exposes VAI.ask — the widget may load after this script */
+    var started=false;
