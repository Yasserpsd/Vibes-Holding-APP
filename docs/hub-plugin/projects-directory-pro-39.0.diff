+    return ['type' => 'project', 'id' => (string)$pid, 'title' => $title, 'text' => mb_substr(implode("\n", $lines), 0, 6000, 'UTF-8')];
+}
+add_action('wp_footer', 'pdp_ai_ask_frontend', 990);
