diff --git a/work/pb/inc/bridge.php b/work/pb/inc/bridge.php
new file mode 100644
index 0000000..ac0a3b0
--- /dev/null
+++ b/work/pb/inc/bridge.php
@@ -0,0 +1,359 @@
+<?php
+/**
+ * Projects Bank — app bridge (v39)
+ * ------------------------------------------------------------
+ * POST /wp-json/pb/v1/bridge/{op} for the Investors Club app server only (contract: BRIDGE_V2.md, section 2).
+ *  - Key: header X-PB-Bridge-Key only. The option pdp_bridge_key_hash keeps sha256(key); the key itself is shown once.
+ *    The feed key (pdp_ai_key) is never accepted here, and this key never opens the feed.
+ *  - The caller passes the member's period (is_member, member_end, member_days) because this plugin cannot ask the hub server-side.
+ *  - Founder contact data leaves only through pdp_gate_contact_payload(), only in `unlock`, only for a member who holds that project.
+ *  - Project save / publish / trash → signed, non-blocking webhook `project.changed {pid}` (option pdp_bridge_webhook).
+ */
+if (!defined('ABSPATH')) exit;
+
+// ========== B1. Key (stored hashed) and webhook address ==========
+function pdp_bridge_key_hash() {
+    $h = get_option('pdp_bridge_key_hash', '');
+    return (is_string($h) && preg_match('/^[a-f0-9]{64}$/i', $h)) ? strtolower($h) : '';
+}
+// 80 characters on purpose: longer than the 64-byte HMAC block, see pdp_bridge_send()
+function pdp_bridge_key_generate() {
+    $k = wp_generate_password(80, false, false);
+    update_option('pdp_bridge_key_hash', hash('sha256', $k), false);
+    update_option('pdp_bridge_key_at', time(), false);
+    return $k;
+}
+function pdp_bridge_url() { return home_url('/wp-json/pb/v1/bridge'); }
+function pdp_bridge_webhook_url() {
+    $u = trim((string)get_option('pdp_bridge_webhook', ''));
+    return stripos($u, 'http') === 0 ? $u : '';
+}
+
+// ========== B2. REST: one POST route, key in the header, op in the path ==========
+add_action('rest_api_init', function () {
+    register_rest_route('pb/v1', '/bridge/(?P<op>[a-z_]+)', ['methods' => 'POST', 'permission_callback' => '__return_true', 'callback' => 'pdp_bridge_rest']);
+});
+// every bridge answer (errors too) is member data: never cached
+add_filter('rest_post_dispatch', function ($response, $server, $request) {
+    if ($response instanceof WP_HTTP_Response && strpos((string)$request->get_route(), '/pb/v1/bridge/') === 0) $response->header('Cache-Control', 'no-store');
+    return $response;
+}, 10, 3);
+function pdp_bridge_error($code, $msg, $status) { return new WP_Error($code, $msg, ['status' => (int)$status]); }
+function pdp_bridge_key_ok(WP_REST_Request $req) {
+    $given = trim((string)$req->get_header('X-PB-Bridge-Key'));
+    $hash = pdp_bridge_key_hash();
+    return $given !== '' && $hash !== '' && hash_equals($hash, hash('sha256', $given));
+}
+function pdp_bridge_ops() {
+    return [
+        'ping'     => 'pdp_bridge_op_ping',
+        'balance'  => 'pdp_bridge_op_balance',
+        'balances' => 'pdp_bridge_op_balances',
+        'unlock'   => 'pdp_bridge_op_unlock',
+        'grant'    => 'pdp_bridge_op_grant',
+        'unlocks'  => 'pdp_bridge_op_unlocks',
+    ];
+}
+function pdp_bridge_rest(WP_REST_Request $req) {
+    if (!pdp_bridge_key_ok($req)) return pdp_bridge_error('forbidden', 'مفتاح الجسر غير صحيح', 403);
+    $ops = pdp_bridge_ops();
+    $op = (string)$req->get_param('op');
+    if (!isset($ops[$op])) return pdp_bridge_error('unknown_op', 'عملية غير معروفة', 404);
+    if (!function_exists('pdp_gate_do_unlock')) return pdp_bridge_error('gate_missing', 'ملف inc/gate.php ناقص', 500);
+    $body = $req->get_json_params();
+    if (!is_array($body)) $body = [];
+    $res = call_user_func($ops[$op], $body);
+    if (is_wp_error($res)) return $res;
+    return array_merge(['ok' => true], $res);
+}
+
+// ========== B3. The member the caller vouches for ==========
+// member{contact_id, is_member (0|1), member_end (Y-m-d, Riyadh), member_days, name, email, phone} → the array shape the gate helpers expect
+function pdp_bridge_member($raw) {
+    if (!is_array($raw)) return null;
+    $cid = isset($raw['contact_id']) ? absint($raw['contact_id']) : 0;
+    if (!$cid) return null;
+    $end = isset($raw['member_end']) ? sanitize_text_field((string)$raw['member_end']) : '';
+    if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $end)) $end = '';
+    $m = [
+        'id'          => $cid,
+        'member_end'  => $end,
+        'member_days' => isset($raw['member_days']) ? max(0, (int)$raw['member_days']) : 0,
+        'name'        => isset($raw['name']) ? sanitize_text_field((string)$raw['name']) : '',
+        'email'       => isset($raw['email']) ? sanitize_email((string)$raw['email']) : '',
+        'phone'       => isset($raw['phone']) ? sanitize_text_field((string)$raw['phone']) : '',
+    ];
+    if (array_key_exists('is_member', $raw)) $m['is_member'] = !empty($raw['is_member']) ? 1 : 0;
+    return $m;
+}
+// Fails closed. A member_end before today (Riyadh) is never a member, whatever the flag says, and is_member:0 is never a member.
+// An empty member_end proves nothing: the hub sends it for a membership without expiry and also for an account that never paid
+// or was revoked (member_days then falls back to the hub default), so it counts only when the caller vouches is_member:1.
+function pdp_bridge_is_member($m) {
+    $flag = isset($m['is_member']) ? (bool)$m['is_member'] : null;
+    if ($m['member_end'] === '') return $flag === true;
+    return $flag !== false && strcmp($m['member_end'], gmdate('Y-m-d', time() + 3 * HOUR_IN_SECONDS)) >= 0;
+}
+function pdp_bridge_balance($m) {
+    $s = pdp_gate_settings();
+    $start = pdp_gate_period_start($m);
+    $granted = pdp_gate_granted($m['id'], $start);
+    $used = pdp_gate_used($m['id'], $m);
+    return ['credits' => (int)$s['credits'], 'granted' => $granted, 'used' => $used, 'left' => max(0, (int)$s['credits'] + $granted - $used), 'period_start' => $start];
+}
+// The only place locked founder data leaves through the bridge (contract shape: whatsapp, email, website, pitch_url)
+function pdp_bridge_contact($pid) {
+    $p = pdp_gate_contact_payload($pid, 'ar');
+    return ['whatsapp' => (string)$p['whatsapp'], 'email' => (string)$p['email'], 'website' => (string)$p['website'], 'pitch_url' => (string)$p['pitch']];
+}
+
+// ========== B4. Ops ==========
+function pdp_bridge_op_ping($body) {
+    return ['version' => PDP_VERSION];
+}
+// `unlocked` = every year, `used` = this membership year
+function pdp_bridge_op_balance($body) {
+    $m = pdp_bridge_member(isset($body['member']) ? $body['member'] : null);
+    if (!$m) return pdp_bridge_error('bad_member', 'بيانات العضو ناقصة', 400);
+    $out = pdp_bridge_balance($m);
+    $out['unlocked'] = array_values(array_map('intval', array_keys(pdp_gate_unlocked_map($m['id']))));
+    return $out;
+}
+// Two queries in total, whatever the number of members (no lazy binding of loose grants here: they are only counted)
+function pdp_bridge_op_balances($body) {
+    global $wpdb;
+    $list = (isset($body['members']) && is_array($body['members'])) ? $body['members'] : [];
+    if (count($list) > 200) return pdp_bridge_error('too_many', 'الحد الأقصى 200 عضو في الطلب الواحد', 400);
+    $members = [];
+    foreach ($list as $raw) { $m = pdp_bridge_member($raw); if ($m) $members[$m['id']] = $m; }
+    if (!$members) return ['items' => new stdClass()];
+    $ids = array_keys($members);
+    $in = implode(',', array_fill(0, count($ids), '%d'));
+    $t = pdp_gate_table();
+    $g = pdp_gate_grants_table();
+    $urows = $wpdb->get_results($wpdb->prepare("SELECT contact_id, unlocked_at FROM $t WHERE contact_id IN ($in)", $ids));
+    $grows = $wpdb->get_results($wpdb->prepare("SELECT contact_id, period_start, SUM(amount) AS total FROM $g WHERE contact_id IN ($in) GROUP BY contact_id, period_start", $ids));
+    $unlocks = [];
+    foreach ((array)$urows as $r) $unlocks[(int)$r->contact_id][] = (string)$r->unlocked_at;
+    $grants = [];
+    foreach ((array)$grows as $r) $grants[(int)$r->contact_id][(string)$r->period_start] = (int)$r->total;
+    $credits = (int)pdp_gate_settings()['credits'];
+    $items = [];
+    foreach ($members as $cid => $m) {
+        $start = pdp_gate_period_start($m);
+        $used = 0;
+        $dates = isset($unlocks[$cid]) ? $unlocks[$cid] : [];
+        foreach ($dates as $at) { if ($start === '' || ($at !== '' && strcmp($at, $start) >= 0)) $used++; }
+        $granted = isset($grants[$cid][$start]) ? $grants[$cid][$start] : 0;
+        if ($start !== '' && isset($grants[$cid][''])) $granted += $grants[$cid][''];
+        $items[(string)$cid] = ['credits' => $credits, 'granted' => $granted, 'used' => $used, 'left' => max(0, $credits + $granted - $used)];
+    }
+    return ['items' => (object)$items];
+}
+// Golden projects cost nothing and are never unlocked: their contact goes through the public partnership link of the feed
+function pdp_bridge_op_unlock($body) {
+    $m = pdp_bridge_member(isset($body['member']) ? $body['member'] : null);
+    if (!$m) return pdp_bridge_error('bad_member', 'بيانات العضو ناقصة', 400);
+    $pid = isset($body['pid']) ? absint($body['pid']) : 0;
+    if (!$pid || get_post_type($pid) !== 'project' || get_post_status($pid) !== 'publish') return pdp_bridge_error('not_found', 'المشروع غير موجود', 404);
+    if (get_post_meta($pid, 'is_featured', true) === '1') {
+        $b = pdp_bridge_balance($m);
+        return ['already' => false, 'golden' => true, 'left' => (int)$b['left'], 'contact' => ['whatsapp' => '', 'email' => '', 'website' => '', 'pitch_url' => '']];
+    }
+    if (!pdp_bridge_is_member($m)) return pdp_bridge_error('not_member', 'العضوية السنوية غير مفعّلة', 403);
+    $r = pdp_gate_do_unlock($m, $pid);
+    if (empty($r['ok'])) {
+        if ($r['code'] === 'no_credit') return pdp_bridge_error('no_credit', 'لا يوجد رصيد متبقٍ في سنة العضوية الحالية', 402);
+        return pdp_bridge_error($r['code'] === 'busy' ? 'busy' : 'db_error', 'تعذّر فتح المشروع الآن، أعد المحاولة', 503);
+    }
+    return ['already' => !empty($r['already']), 'left' => (int)$r['left'], 'contact' => pdp_bridge_contact($pid)];
+}
+// amount may be negative. A deduction never takes the year's allowance below what the member already used, so it needs `member`
+// (the year is unknown without it); an addition is always accepted. Without `member` an addition is saved without a year and joins
+// the first membership year seen for this member (granted / left then count only what is known here).
+// `ref` (optional, the caller's id of this one action) makes a retry harmless: the same ref answers already:true and adds nothing.
+function pdp_bridge_op_grant($body) {
+    $cid = isset($body['contact_id']) ? absint($body['contact_id']) : 0;
+    $amount = isset($body['amount']) ? (int)$body['amount'] : 0;
+    if (!$cid) return pdp_bridge_error('bad_request', 'رقم الحساب ناقص', 400);
+    if ($amount === 0 || abs($amount) > 1000) return pdp_bridge_error('bad_amount', 'قيمة الرصيد غير صحيحة', 400);
+    $ref = isset($body['ref']) ? sanitize_text_field((string)$body['ref']) : '';
+    if ($ref !== '' && !preg_match('/^[A-Za-z0-9_.:-]{1,64}$/', $ref)) return pdp_bridge_error('bad_ref', 'مرجع العملية غير صحيح', 400);
+    $m = ['id' => $cid, 'member_end' => '', 'member_days' => 0];
+    if (isset($body['member'])) {
+        $m = pdp_bridge_member($body['member']);
+        if (!$m || $m['id'] !== $cid) return pdp_bridge_error('bad_member', 'بيانات العضو لا تطابق رقم الحساب', 400);
+    } elseif ($amount < 0) {
+        return pdp_bridge_error('bad_member', 'خصم الرصيد يحتاج بيانات عضوية العضو لمعرفة سنة عضويته', 400);
+    }
+    $row = [
+        'contact_id' => $cid,
+        'amount'     => $amount,
+        'note'       => isset($body['note']) ? mb_substr(sanitize_text_field((string)$body['note']), 0, 255) : '',
+        'actor'      => isset($body['actor']) ? mb_substr(sanitize_text_field((string)$body['actor']), 0, 190) : '',
+        'ref'        => $ref !== '' ? $ref : null,
+    ];
+    // the same lock as pdp_gate_do_unlock: no unlock slips in between the balance read and the insert
+    $held = pdp_gate_lock($cid);
+    if ($held === false) return pdp_bridge_error('busy', 'تعذّر حفظ الرصيد الآن، أعد المحاولة', 503);
+    $res = pdp_bridge_grant_save($m, $row);
+    pdp_gate_release($cid, $held);
+    return $res;
+}
+// Runs under the member's lock: balance, floor check and insert see the same rows
+function pdp_bridge_grant_save($m, $row) {
+    global $wpdb;
+    $amount = (int)$row['amount'];
+    $b = pdp_bridge_balance($m);
+    $known = pdp_bridge_grant_known($row, $b);
+    if ($known !== null) return $known;
