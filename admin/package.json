{
  "name": "investors-club-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Web dashboard for the Investors Club app (Vibes Holding). Hub admin accounts only.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "node server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "i18n:check": "node scripts/i18n-extract.mjs"
  },
  "dependencies": {
    "globe.gl": "^2.46.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
