# Copy this file to server/.env (git-ignored) and fill the values yourself.
# Never paste real keys in chat, code or git.
APP_ENV=test
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Optional locally: when empty the server keeps content in memory.
# On Railway the Postgres plugin injects DATABASE_URL automatically.
DATABASE_URL=

# Projects Bank feed (vibesholding.com). The key is a secret: env only.
PB_FEED_URL=https://vibesholding.com/wp-json/pb/v1/projects
PB_FEED_KEY=
PB_REFRESH_MINUTES=10

# vcmem.com hub (Vibes AI Assistant plugin). The app server is a tenant site of the hub:
# create it in the hub's «المواقع» page and paste its key here. Secret: env only.
# HUB_MODE=mock runs without the hub (e-mail code 123456, every account is an admin). Never in production.
HUB_MODE=mock
HUB_URL=https://vcmem.com
HUB_SITE_KEY=
# Test environment only: 1 opens registration on the live hub (needs the owner's OK).
HUB_ALLOW_TEST_REGISTRATION=0
SESSION_DAYS=180
NEWS_REFRESH_MINUTES=
NEWS_MAX_AGE_DAYS=
NEWS_MAX_NEW_PER_RUN=
OPENAI_API_KEY=
OPENAI_MODEL=
# Video library: the club channel handle or id; the Data API key (optional) lists the whole catalogue,
# without it the public feed lists the latest uploads. 0 disables polling.
YOUTUBE_CHANNEL=@investorscl
YOUTUBE_API_KEY=
VIDEOS_REFRESH_MINUTES=
