# Copy this file to server/.env (git-ignored) and fill the values yourself.
# Never paste real keys in chat, code or git.
APP_ENV=test
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Optional locally: when empty the server keeps content in memory.
# On Railway the Postgres plugin injects DATABASE_URL automatically.
DATABASE_URL=

# Projects Bank feed (vibesholding.com). The key is a secret: env only.
PB_FEED_URL=https://vibesholding.com/wp-json/pb/v1/projects
PB_FEED_KEY=
PB_REFRESH_MINUTES=10
# Projects Bank bridge (plugin 39.0, docs/BRIDGE_V2.md 2): members' balance, unlock and the dashboard's grant.
# The key is shown once in the plugin's settings; it also signs the plugin's webhook to /api/webhooks/pb
# (plugin setting pdp_bridge_webhook = <this server>/api/webhooks/pb). Secret: env only. Empty = mock with the mock hub, else off.
PB_BRIDGE_URL=
PB_BRIDGE_KEY=

# vcmem.com hub (Vibes AI Assistant plugin). The app server is a tenant site of the hub:
# create it in the hub's «المواقع» page and paste its key here. Secret: env only.
# HUB_MODE=mock runs without the hub (e-mail code 123456, every account is an admin). Never in production.
HUB_MODE=mock
HUB_URL=https://vcmem.com
HUB_SITE_KEY=
# Test environment only: 1 opens registration on the live hub (needs the owner's OK).
HUB_ALLOW_TEST_REGISTRATION=0
# Bridge v2 (plugin 2.7.0): tick «خادم التطبيق (صلاحيات إدارية)» on this site's row in the hub's «المواقع» page.
# Instant sync: hub settings app_webhook_url = <this server>/api/webhooks/hub and app_webhook_secret (shown once) here.
# Secret: env only. Empty = the webhook answers 503 and the app learns of changes at the next refresh.
HUB_WEBHOOK_SECRET=
SESSION_DAYS=180
# Dashboard sign-in code by e-mail (M18): 1 asks every dashboard sign-in for a code mailed to the admin's hub e-mail.
# Needs working SMTP_* values. /health -> hub.adminOtp: 'no_mail' = SMTP not set; 'on' only means SMTP is configured, not that mail arrives.
# Locked out (the code never arrives / otp_mail_failed)? Set ADMIN_OTP=0 and redeploy: the dashboard signs in with the hub password alone again.
ADMIN_OTP=0
ADMIN_OTP_SECONDS=60
ADMIN_SESSION_HOURS=12
NEWS_REFRESH_MINUTES=
NEWS_MAX_AGE_DAYS=
NEWS_MAX_NEW_PER_RUN=
OPENAI_API_KEY=
OPENAI_MODEL=
# Video library: the club channel handle or id; the Data API key (optional) lists the whole catalogue,
# without it the public feed lists the latest uploads. 0 disables polling.
YOUTUBE_CHANNEL=@investorscl
YOUTUBE_API_KEY=
VIDEOS_REFRESH_MINUTES=

# Public base URL of this server (Paymob callbacks and the payment pages). Railway sets RAILWAY_PUBLIC_DOMAIN
# automatically; set PUBLIC_URL only to override it (local emulator runs: http://10.0.2.2:3000).
PUBLIC_URL=

# Paymob KSA, real-world services only (CLAUDE.md rule 3). TEST keys in the test environment.
# Without the four values the server runs the mock gateway (local checkout page, same signed callback).
PAYMOB_MODE=
PAYMOB_BASE_URL=https://ksa.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=

# Management notifications, sent from the website's hosting mailbox (vcmem.com). Without SMTP_HOST the
# mails are only logged. NOTIFY_EMAIL = comma separated recipients, like the plugin's notify_email option.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
NOTIFY_EMAIL=

# Web dashboard (admin/): browser origins allowed to call this API, comma separated, no path.
# Example: https://dashboard.vibesholdingsa.com  (local dashboard dev server: http://localhost:5173)
ADMIN_ORIGINS=

# Uploaded images and video of the dashboard's posts (M15). On Railway: create a Bucket in the project and set
# these five by variable reference to it, e.g. S3_BUCKET=${{club-media.BUCKET}}, S3_ENDPOINT=${{club-media.ENDPOINT}},
# S3_REGION=${{club-media.REGION}}, S3_ACCESS_KEY_ID=${{club-media.ACCESS_KEY_ID}}, S3_SECRET_ACCESS_KEY=${{club-media.SECRET_ACCESS_KEY}}.
# The server sets the bucket's CORS rules from ADMIN_ORIGINS at boot (/health -> uploads.cors).
# Left empty, files go to UPLOADS_DIR on the local disk: development only, they vanish on every Railway deploy.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 1 only for an old bucket whose Credentials tab asks for path-style URLs.
S3_FORCE_PATH_STYLE=
UPLOADS_DIR=./data/uploads
# 1 on the ONE server that owns the bucket and keeps its posts in Postgres: it deletes day-old files none of its posts use.
# Never point a local server at the live bucket: it would rewrite the bucket's CORS rules (and, with the sweep on, delete files).
UPLOADS_SWEEP=
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_VIDEO_MB=200

# Store purchases (RevenueCat webhook → hub membership activation). Any long random string; the same
# value goes in the RevenueCat webhook "Authorization header" field.
REVENUECAT_WEBHOOK_AUTH=

# RevenueCat public SDK keys (goog_… / appl_…; they ship in the app, read by GET /api/membership/store). Without
# a key the membership screen says store purchase is not available on that platform yet.
REVENUECAT_PUBLIC_KEY_ANDROID=
REVENUECAT_PUBLIC_KEY_IOS=
# Optional secret (sk_…): lets POST /api/membership/sync read the entitlement from RevenueCat's REST API when the
# webhook is late or missing. Secret: env only.
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=membership
STORE_MEMBERSHIP_PRODUCT=club_membership_annual
# Terms and privacy pages shown next to the subscription price (store review requirement).
STORE_TERMS_URL=
STORE_PRIVACY_URL=

# Member push notifications go through Expo's push service (no key needed). Set the access token only when
# "enhanced push security" is enabled for the Expo project.
EXPO_PUSH_ACCESS_TOKEN=
