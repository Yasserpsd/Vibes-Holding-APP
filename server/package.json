{
  "name": "investors-club-server",
  "version": "0.1.0",
  "private": true,
  "description": "API server for the Investors Club app (Vibes Holding). Test environment.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "strings": "node scripts/sync-app-strings.mjs",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "seed": "tsx src/cli/seed.ts",
    "feed:inspect": "tsx src/cli/inspect-feed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-presigned-post": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.4",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
